// TrainFlow TMS — Enterprise Prisma Schema
// =====================================================================
// Architecture requirements implemented:
//  - UUID primary keys for every table
//  - Audit columns: createdAt, updatedAt, createdBy, updatedBy, deletedAt (soft delete)
//  - Soft delete across all business modules
//  - Multi-tenant ready (Tenant model + tenantId on business entities)
//  - Bilingual (EN/AR) via Language model
//  - Question Bank (course-agnostic + course-linked)
//  - QR attendance (CheckInAttempt) + QR certificate verification (CertVerification)
//  - Reference number counters (RefNumberCounter)
//  - Workflow states on TrainingRequest (Draft → Submitted → Under Review → Approved → Scheduled → In Progress → Completed → Cancelled/Rejected)
//  - Future-proof: AI exam fields, mobile support, notifications, reporting

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum UserRole {
  SUPER_ADMIN
  COORDINATOR
  TRAINER
  CONTRACTOR
  VIEWER
}

enum TrainingRequestStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  REJECTED
  // Returned to the contractor for revision; resubmitting moves it back to SUBMITTED.
  REQUIRES_MODIFICATION
  // Terminal: the single permitted official retest failed, so the request is closed
  // and the contractor must raise a new one.
  CLOSED
}

enum SessionStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum QuestionType {
  SINGLE_CHOICE
  MULTIPLE_CHOICE
  TRUE_FALSE
  SHORT_ANSWER
}

enum TestType {
  PRE_TEST
  FINAL_TEST
}

enum QuestionSource {
  MANUAL
  AI_GENERATED
  IMPORTED
}

// ─────────────────────────────────────────────────────────────────────────────
// FOUNDATION — Tenant, Language, Role, Permission, User, Setting
// ─────────────────────────────────────────────────────────────────────────────

model Tenant {
  id        String    @id @default(uuid())
  name      String
  nameAr    String?
  code      String    @unique
  status    String    @default("ACTIVE") // ACTIVE | SUSPENDED
  config    String? // JSON — tenant-specific config
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  users     User[]
  companies Company[]
  trainers  Trainer[]
  courses   Course[]

  @@index([status])
}

model Language {
  id         String   @id @default(uuid())
  code       String   @unique // "en" | "ar"
  name       String // "English"
  nameNative String // "English" | "العربية"
  direction  String   @default("ltr") // "ltr" | "rtl"
  isDefault  Boolean  @default(false)
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model Role {
  id          String    @id @default(uuid())
  code        String    @unique // "SUPER_ADMIN" | "COORDINATOR" | "TRAINER" | "CONTRACTOR" | "VIEWER"
  name        String
  nameAr      String?
  description String?
  isSystem    Boolean   @default(false) // system roles cannot be deleted
  // Which UserRole "bucket" a user assigned to this role is treated as for
  // tenant-row-scoping (CONTRACTOR) and fixed platform-admin gates (SUPER_ADMIN
  // only settings/users/roles) — those two concerns stay enum-keyed even though
  // operational module/action permissions below are fully dynamic.
  baseType    UserRole  @default(CONTRACTOR)
  permissions Json? // array of "module.action" / "module.*" / "*" — the live RBAC source
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?

  users User[] @relation("UserRole")
}

model Permission {
  id          String   @id @default(uuid())
  code        String   @unique // e.g. "companies.view", "companies.create"
  module      String // "companies" | "trainers" | ...
  action      String // "view" | "create" | "edit" | "delete"
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([module])
  @@index([action])
}

model User {
  id                  String    @id @default(uuid())
  email               String    @unique
  passwordHash        String
  fullName            String
  phone               String?
  jobTitle            String?
  role                UserRole  @default(CONTRACTOR)
  roleId              String? // link to Role table for dynamic RBAC
  language            String    @default("en")
  timezone            String?   @default("Asia/Riyadh")
  // Coordinator primary region + coverage.
  // `region` = the coordinator's assigned operational region
  // (CENTRAL | EASTERN | WESTERN | SOUTHERN). When set on a coordinator,
  // server-side scoping restricts them to companies/requests/trainees within
  // that region. `regionsCovered` is a JSON string array of extra regions a
  // coordinator may cover temporarily (assigned by an admin) — the coordinator
  // can operate in their own region PLUS every covered region, without any
  // role change. Trainers/users of other roles may carry a region too but it
  // has no authorization effect for them.
  region            String?
  regionsCovered    String? // JSON array of region codes the coordinator covers
  isActive            Boolean   @default(true)
  accountStatus       String    @default("ACTIVE") // ACTIVE | PENDING_APPROVAL | SUSPENDED | REJECTED | LOCKED
  avatarUrl           String?
  lastLoginAt         DateTime?
  forcePasswordChange Boolean   @default(false)
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  tokenVersion        Int       @default(0) // bump to revoke all outstanding sessions
  tenantId            String?
  // Relations for contractor/trainer users
  companyId           String?
  trainerId           String?   @unique
  // Registration info (for contractor self-registration)
  registrationData    String? // JSON: { companyName, crNumber, contactPerson, nationalId, mobile }
  // Audit
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
  createdBy           String?
  updatedBy           String?
  deletedAt           DateTime?

  tenant     Tenant?  @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  company    Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)
  trainer    Trainer? @relation(fields: [trainerId], references: [id], onDelete: SetNull)
  roleRecord Role?    @relation("UserRole", fields: [roleId], references: [id], onDelete: SetNull)

  auditLogs          AuditLog[]
  notifications      Notification[]
  loginHistory       LoginHistory[]
  assignedRequests   TrainingRequest[] @relation("AssignedCoordinator")
  assignedClaims     TrainerClaim[]    @relation("ClaimCoordinator")

  @@index([role])
  @@index([companyId])
  @@index([tenantId])
  @@index([accountStatus])
}

// Tracks every login attempt (success + failure)
model LoginHistory {
  id            String   @id @default(uuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  email         String // email attempted
  success       Boolean
  failureReason String?
  ipAddress     String?
  userAgent     String?
  attemptedAt   DateTime @default(now())

  @@index([userId])
  @@index([email])
  @@index([attemptedAt])
}

model Setting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  category    String   @default("GENERAL") // GENERAL | BRANDING | NOTIFICATION | SECURITY | EMAIL | SYSTEM
  description String?
  isPublic    Boolean  @default(false) // safe to expose to client
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  updatedBy   String?
}

// ─────────────────────────────────────────────────────────────────────────────
// REFERENCE NUMBER COUNTER (atomic sequence generator)
// ─────────────────────────────────────────────────────────────────────────────

model RefNumberCounter {
  id         String   @id @default(uuid())
  entityType String // "TRAINING_REQUEST" | "CERTIFICATE" | "EXAM" | "TRAINER" | "COMPANY" | "COURSE" | "SESSION" | "CLAIM"
  year       Int? // 0 for non-yearly sequences (TRN, COM, CRS) — never NULL: @@unique cannot match NULL
  sequence   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([entityType, year])
}

// ─────────────────────────────────────────────────────────────────────────────
// COMPANIES (Contractor Companies — also act as tenants' clients)
// ─────────────────────────────────────────────────────────────────────────────

model Company {
  id            String    @id @default(uuid())
  refNumber     String    @unique // COM-000001
  name          String
  nameAr        String?
  legalName     String?
  crNumber      String?
  vatNumber     String?
  industry      String?
  country       String?
  city          String?
  // Operational region of the company
  // (CENTRAL | EASTERN | WESTERN | SOUTHERN). Coordinator scoping matches a
  // company's region against the coordinator's region + coverage. Null means
  // "region not assigned" — such companies are visible to coordinators who
  // have no region assignment, but hidden from coordinators scoped to a region.
  region        String?
  address       String?
  postalCode    String?
  phone         String?
  email         String?
  website       String?
  contactPerson String?
  contactPhone  String?
  contactEmail  String?
  status        String    @default("ACTIVE")
  logoUrl       String?
  tenantId      String?
  // Audit
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  createdBy     String?
  updatedBy     String?
  deletedAt     DateTime?

  tenant             Tenant?             @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  contacts           CompanyContact[]
  trainees           Trainee[]
  users              User[]
  trainingRequests   TrainingRequest[]
  certificates       Certificate[]
  sessionEnrollments SessionEnrollment[]
  sessionCompanies   SessionCompany[]
  sessionPayments    SessionPayment[]
  examAttempts       ExamAttempt[]
  testResults        TestResult[]
  courseEvaluations  CourseEvaluation[]
  workerPassports    WorkerPassport[]
  quotations         Quotation[]
  invoices           Invoice[]
  payments           Payment[]
  receipts           Receipt[]
  notificationLogs   NotificationLog[]

  @@index([status])
  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────────────────────
// TRAINEES (each belongs to one company)
// ─────────────────────────────────────────────────────────────────────────────

model Trainee {
  id          String    @id @default(uuid())
  refNumber   String    @unique // TRA-000001
  fullName    String
  nationalId  String // National ID / Iqama — unique (duplicates prevented at app level)
  nationality String?
  jobTitle    String?
  mobile      String?
  email       String?
  companyId   String
  status      String    @default("ACTIVE") // ACTIVE | INACTIVE
  notes       String?
  idAttachmentUrl String?
  dateOfBirth DateTime?
  idExpiry    DateTime?
  // ── Multi-document support (Iqama, ID, Passport, Certificate, Medical, Other) ──
  // JSON-encoded array of { url, filename, type, uploadedAt, uploadedById }.
  // Kept as a single String column on SQLite to avoid a separate join table
  // while still supporting arbitrary document types per trainee.
  documents   String?
  // Audit
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?

  company            Company                        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  requestCourses     TrainingRequestCourseTrainee[]
  sessionEnrollments SessionEnrollment[]

  @@index([companyId])
  @@index([nationalId])
  @@index([status])
}

model CompanyContact {
  id               String    @id @default(uuid())
  companyId        String
  fullName         String // English name
  fullNameAr       String? // Arabic name — shown in Arabic UI
  jobTitle         String? // Position
  email            String?
  phone            String?
  mobile           String?
  contactType      String? // Optional type/purpose: OPERATIONS | HR | ADMIN | PAYROLL | QUALITY | OTHER
  preferredContact String? // PHONE | MOBILE | EMAIL | WHATSAPP
  isPrimary        Boolean   @default(false)
  isActive         Boolean   @default(true)
  notes            String?
  // Audit
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        String?
  updatedBy        String?
  deletedAt        DateTime?

  company          Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  trainingRequests TrainingRequest[]

  @@index([companyId])
  @@index([contactType])
}

// ─────────────────────────────────────────────────────────────────────────────
// TRAINERS & QUALIFICATIONS
// ─────────────────────────────────────────────────────────────────────────────

model Trainer {
    id          String    @id @default(uuid())
    refNumber   String    @unique // TRN-000001
    nameEn      String // Official English name (manually edited, never auto-translated)
    nameAr      String? // Arabic name, shown when the system locale is Arabic
    nationalId  String?   @unique
  email       String?   @unique
  phone       String?
  mobile      String?
  gender      String?
  nationality String?
  country     String?
  city        String?
  address     String?
  bio                   String?
  photoUrl              String?
  status                String    @default("ACTIVE")
  hireDate              DateTime?
  // Employee (staff) vs Contractor/Collaborator (consultant). Decides which claim
  // rules apply: employees receive the fixed daily overtime allowance (4h Sun–Thu,
  // 12h Fri/Sat); contractors get their actual session hours (never labeled OT)
  // and the contractor daily allowance for business missions.
  engagementType        String    @default("EMPLOYEE") // EMPLOYEE | CONTRACTOR
  tenantId              String?
  // Derived from the Excel authorization baseline (14 July 2026). Display-only;
  // the authoritative grants live in TrainerCertification + WorkshopTrainerAuthorization.
  primarySpecialization String?
  // Audit
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  createdBy             String?
  updatedBy             String?
  deletedAt             DateTime?

  tenant                Tenant?                    @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  qualifications        TrainerQualification[]
  certifications        TrainerCertification[]
  workshopAuthorizations WorkshopTrainerAuthorization[]
  user                  User?
  sessions              TrainingSession[]
  evaluations           CourseEvaluation[]
  claims                TrainerClaim[]

  @@index([status])
  @@index([tenantId])
}

model TrainerQualification {
  id               String    @id @default(uuid())
  trainerId        String
  title            String
  issuer           String?
  credentialNumber String?
  issueDate        DateTime?
  expiryDate       DateTime?
  documentUrl      String?
  status           String    @default("VALID") // VALID | EXPIRED | EXPIRING_SOON
  // Audit
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        String?
  updatedBy        String?
  deletedAt        DateTime?

  trainer        Trainer                @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  certifications TrainerCertification[]

  @@index([trainerId])
  @@index([status])
}

// Trainer-Course certification link — a trainer can only teach courses they're certified for
model TrainerCertification {
  id              String    @id @default(uuid())
  trainerId       String
  courseId        String
  qualificationId String? // optional link to source qualification
  validFrom       DateTime  @default(now())
  validUntil      DateTime?
  status          String    @default("VALID") // VALID | EXPIRED | REVOKED
  notes           String?
  // Audit
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?

  trainer       Trainer               @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  course        Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  qualification TrainerQualification? @relation(fields: [qualificationId], references: [id], onDelete: SetNull)

  @@unique([trainerId, courseId, deletedAt])
  @@index([trainerId])
  @@index([courseId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// COURSES (catalog) + QUESTION BANK
// ─────────────────────────────────────────────────────────────────────────────

model Course {
  id             String    @id @default(uuid())
  refNumber      String    @unique // CRS-000001
  code           String    @unique
  title          String
  titleAr        String?
  description    String?
  category       String?
  durationHours  Int       @default(6)
  language       String    @default("en")
  validityMonths Int       @default(12)
  passScore      Int       @default(70)
  maxTrainees    Int       @default(20)
  hasPreTest     Boolean   @default(true)
  hasFinalTest   Boolean   @default(true)
  hasEvaluation  Boolean   @default(true)
  status         String    @default("ACTIVE")
  tenantId       String?
  // AI-assisted exam support
  aiExamEnabled  Boolean   @default(false)
  aiExamConfig   String? // JSON: difficulty distribution, num questions, etc.
  // Certificate Release Security: requires profession verification (Iqama profession change)
  // before certificates can be released to the contractor.
  requiresProfessionVerification Boolean @default(false)
  retakeAttempts Int @default(1)
  // Audit
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?

  tenant                Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  requests              TrainingRequest[]
  requestCourses        TrainingRequestCourse[]
  sessions              TrainingSession[]
  questions             Question[]
  certificates          Certificate[]
  trainerCertifications TrainerCertification[]
  complianceRules       ComplianceRule[]
  resources             CourseResource[]

  @@index([status])
  @@index([category])
  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────────────────────
// WORKSHOPS (catalog, separate from Courses) — e.g. Technical Certification Tests
// ─────────────────────────────────────────────────────────────────────────────

model Workshop {
  id             String   @id @default(uuid())
  refNumber      String   @unique // WSH-000001
  code           String   @unique // CTCT06 etc.
  title          String
  description    String?
  category       String?
  durationDays   Int      @default(1)
  durationText   String? // verbatim duration from the source sheet, e.g. "1 Day joint"
  durationHours  Int      @default(8)
  status         String   @default("ACTIVE") // ACTIVE | INACTIVE
  isActive       Boolean  @default(true)
  // Audit
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?

  authorizations WorkshopTrainerAuthorization[]

  @@index([status])
  @@index([category])
  @@index([deletedAt])
}

// Trainer ↔ Workshop authorization link — mirrors TrainerCertification for courses.
model WorkshopTrainerAuthorization {
  id         String    @id @default(uuid())
  workshopId String
  trainerId  String
  validFrom  DateTime  @default(now())
  validUntil DateTime?
  status     String    @default("VALID") // VALID | EXPIRED | REVOKED
  notes      String?
  // Audit
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  createdBy  String?
  updatedBy  String?
  deletedAt  DateTime?

  workshop Workshop @relation(fields: [workshopId], references: [id], onDelete: Cascade)
  trainer  Trainer  @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@unique([workshopId, trainerId, deletedAt])
  @@index([trainerId])
  @@index([workshopId])
  @@index([status])
}

// Sprint 6: Course Resources — course material attachments.
// Two kinds of rows live in this table:
//   - External pointers (PDF, PowerPoint, URL, QR link): `url` is a link.
//   - Uploaded course materials (Phase 1): the file is stored on disk under
//     public/uploads/course-materials/ and served via /api/uploads/...;
//     `storagePath` keeps the on-disk relative path so the future AI Question
//     Generator can read the file content back for question extraction.
//     fileName/fileSize/fileMime mirror the stored file for the UI.
model CourseResource {
  id          String   @id @default(uuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  type        String   // "PDF" | "POWERPOINT" | "WORD" | "URL" | "QR_CODE"
  title       String
  titleAr     String?
  url         String
  description String?
  // Uploaded-file metadata (null for external URL/QR_CODE pointers)
  fileName    String?
  fileSize    Int?
  fileMime    String?
  storagePath String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?

  questions Question[]

  @@index([courseId])
  @@index([type])
}

// Question Bank — questions can be course-specific OR shared in the bank
model Question {
  id             String         @id @default(uuid())
  courseId       String? // nullable → bank-only question
  course         Course?        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  // Optional link to the course material this question was generated from.
  // SetNull so deleting a material never deletes questions already in the bank.
  materialId     String?
  material       CourseResource? @relation(fields: [materialId], references: [id], onDelete: SetNull)
  type           QuestionType   @default(SINGLE_CHOICE)
  testType       TestType       @default(PRE_TEST)
  text           String
  textAr         String?
  options        String // JSON array of strings
  optionsAr      String? // JSON array of Arabic strings, mirrors `options`
  correctAnswers String // JSON array of indices
  points         Int            @default(1)
  order          Int            @default(0)
  isActive       Boolean        @default(true)
  // Question bank metadata
  category       String? // tag for bank browsing
  difficulty     String         @default("MEDIUM") // EASY | MEDIUM | HARD
  tags           String? // JSON array of tags
  imageUrl       String? // optional figure/image shown with the question
  // AI-assisted exam support
  source         QuestionSource @default(MANUAL)
  aiGeneratedAt  DateTime?
  aiModel        String?
  aiPrompt       String?
  // Audit
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?

  @@index([courseId, testType])
  @@index([materialId])
  @@index([category])
  @@index([difficulty])
}

// ─────────────────────────────────────────────────────────────────────────────
// TRAINING REQUESTS (workflow: DRAFT → SUBMITTED → UNDER_REVIEW → APPROVED → SCHEDULED → IN_PROGRESS → COMPLETED | CANCELLED | REJECTED)
// ─────────────────────────────────────────────────────────────────────────────

model TrainingRequest {
  id                String                @id @default(uuid())
  refNumber         String                @unique // TR-YYYY-000001
  companyId         String
  courseId          String? // optional primary course (legacy single-course field)
  contactId         String? // linked company contact (the request's contact person)
  requestedBy       String? // user id
  traineeCount      Int                   @default(0) // total across all courses
  preferredDateFrom DateTime?
  preferredDateTo   DateTime?
  preferredLocation String?
  preferredLanguage String?
  notes             String?
  status            TrainingRequestStatus @default(DRAFT)
  priority          String                @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  rejectionReason   String?
  approvedAt        DateTime?
  approvedBy         String?
  submittedAt       DateTime?
  reviewedAt        DateTime?
  scheduledAt       DateTime?
  startedAt         DateTime?
  completedAt      DateTime?
  cancelledAt       DateTime?
  rejectedAt        DateTime?
  // JSON-encoded array of additional request-level documents
  // (medical certificate, vaccination, work permit, company letter, etc.).
  // Each entry: { url, filename, type, uploadedAt, uploadedById }.
  documents         String?
  // ── Coordinator assignment (smart routing) ──
  // The region the contractor selected for this request (CENTRAL/EASTERN/WESTERN/SOUTHERN).
  // Stored on the request so it survives even if the company's region changes later.
  region            String?
  // The coordinator assigned to handle this request. NULL = auto-assigned or not yet assigned.
  // Set when the contractor picks a specific coordinator OR when the system auto-assigns.
  coordinatorId     String?
  // Audit
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  createdBy         String?
  updatedBy         String?
  deletedAt         DateTime?

  company        Company                 @relation(fields: [companyId], references: [id])
  course         Course?                 @relation(fields: [courseId], references: [id])
  coordinator    User?                   @relation("AssignedCoordinator", fields: [coordinatorId], references: [id])
  contact        CompanyContact?         @relation(fields: [contactId], references: [id], onDelete: SetNull)
  sessions       TrainingSession[]
  requestCourses TrainingRequestCourse[]
  quotations     Quotation[]
  invoices       Invoice[]

  @@index([status])
  @@index([companyId])
  @@index([courseId])
  @@index([coordinatorId])
  @@index([region])
  @@index([contactId])
}

// Junction: a Training Request contains multiple courses, each with its own trainee list
// Business rules: minTrainees=10, maxTrainees=20 per course
model TrainingRequestCourse {
  id           String    @id @default(uuid())
  requestId    String
  courseId     String
  traineeCount Int       @default(0)
  minTrainees  Int       @default(10) // business rule: minimum 10
  maxTrainees  Int       @default(20) // business rule: maximum 20
  notes        String?
  // Audit
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?

  request  TrainingRequest                @relation(fields: [requestId], references: [id], onDelete: Cascade)
  course   Course                         @relation(fields: [courseId], references: [id])
  trainees TrainingRequestCourseTrainee[]
  sessions TrainingSession[]

  @@unique([requestId, courseId, deletedAt])
  @@index([requestId])
  @@index([courseId])
}

// Junction: trainees assigned to a specific course within a training request
model TrainingRequestCourseTrainee {
  id              String    @id @default(uuid())
  requestCourseId String
  traineeId       String
  // Audit
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?

  requestCourse TrainingRequestCourse @relation(fields: [requestCourseId], references: [id], onDelete: Cascade)
  trainee       Trainee               @relation(fields: [traineeId], references: [id], onDelete: Cascade)

  @@unique([requestCourseId, traineeId])
  @@index([requestCourseId])
  @@index([traineeId])
}

// ─────────────────────────────────────────────────────────────────────────────
// MULTI-COMPANY SESSION ENROLLMENT — CENTRAL WORKFLOW ENTITY
// =====================================================================
// SessionEnrollment is the single source of truth for every trainee's
// progress inside a Training Session. It tracks the complete lifecycle:
//
//   Enrollment → Attendance → Pre-Test → Session Lifecycle → Final-Test
//     → Evaluation → Certificate
//
// All downstream modules (Attendance, ExamAttempt, CourseEvaluation,
// Certificate) automatically update these status fields via sync functions.
//
// A Training Session can contain trainees from MULTIPLE companies.
// The trainee's original company is always preserved via Trainee.companyId.
// ─────────────────────────────────────────────────────────────────────────────

model SessionEnrollment {
  id        String          @id @default(uuid())
  sessionId String
  session   TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  traineeId String
  trainee   Trainee         @relation(fields: [traineeId], references: [id], onDelete: Cascade)
  // The trainee's company at time of enrollment (snapshot — preserves original company)
  companyId String // trainee's original company (NOT the session's company)
  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // ── Enrollment lifecycle ──
  enrollmentStatus String    @default("PENDING")
  // PENDING | CONFIRMED | CHECKED_IN | TRAINING | COMPLETED | CANCELLED | NO_SHOW
  enrolledBy       String?
  enrollmentDate   DateTime  @default(now())
  completedDate    DateTime?
  notes            String?

  // ── Re-Exam support ──
  isReExam     Boolean @default(false)

  // ── Trainer Opportunity tracking ──
  // Per business rules: the trainer can give ONE immediate opportunity
  // (same session, no official retest, no notification). These fields
  // track whether the opportunity has been used and its result.
  trainerOpportunityUsed   Boolean   @default(false)
  trainerOpportunityPassed Boolean?
  trainerOpportunityAt     DateTime?
  trainerOpportunityBy     String?

  // ── Enrollment source tracking ──
  enrollmentSource String @default("MANUAL")
  addedByTrainer  Boolean @default(false)
  pendingReview   Boolean @default(false)

  // ── Attendance status ──
  attendanceStatus String @default("NOT_STARTED")
  // NOT_STARTED | PRESENT | LATE | ABSENT

  // ── Pre-Test status ──
  preTestStatus String @default("PENDING")
  // NOT_REQUIRED | PENDING | IN_PROGRESS | COMPLETED

  // ── Final Test status ──
  finalTestStatus String @default("PENDING")
  // NOT_REQUIRED | PENDING | IN_PROGRESS | PASSED | FAILED

  // ── Evaluation status ──
  evaluationStatus String @default("PENDING")
  // NOT_REQUIRED | PENDING | COMPLETED

  // ── Certificate status ──
  certificateStatus String @default("NOT_ELIGIBLE")
  // NOT_ELIGIBLE | ELIGIBLE | GENERATED | ISSUED

  // ── Links to related records (for quick lookup) ──
  attendanceId String? // FK to Attendance record (set at check-in)

  // Audit
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@unique([sessionId, traineeId])
  @@index([sessionId])
  @@index([traineeId])
  @@index([companyId])
  @@index([enrollmentStatus])
  @@index([attendanceStatus])
  @@index([preTestStatus])
  @@index([finalTestStatus])
  @@index([evaluationStatus])
  @@index([certificateStatus])
}

// Tracks which companies have trainees enrolled in a session (for multi-company reporting)
model SessionCompany {
  id           String          @id @default(uuid())
  sessionId    String
  session      TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  companyId    String
  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  traineeCount Int             @default(0)
  addedAt      DateTime        @default(now())
  // Audit
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  createdBy    String?

  @@unique([sessionId, companyId])
  @@index([sessionId])
  @@index([companyId])
}

// ─────────────────────────────────────────────────────────────────────────────
// TRAINING SESSIONS + QR ATTENDANCE
// ─────────────────────────────────────────────────────────────────────────────

model TrainingSession {
  id                String                 @id @default(uuid())
  refNumber         String                 @unique // SES-000001
  courseId          String
  course            Course                 @relation(fields: [courseId], references: [id])
  requestId         String?
  request           TrainingRequest?       @relation(fields: [requestId], references: [id])
  requestCourseId   String? // link to specific course-in-request (multi-course support)
  requestCourse     TrainingRequestCourse? @relation(fields: [requestCourseId], references: [id], onDelete: SetNull)
  trainerId         String?
  trainer           Trainer?               @relation(fields: [trainerId], references: [id])
  title             String
  location          String?
  city              String?
  region            String?
  venue             String?
  shift             String? // MORNING | EVENING
  durationHours     Int                    @default(6)
  capacity          Int                    @default(20)
  language          String                 @default("en")
  startDate         DateTime
  endDate           DateTime
  expectedTrainees  Int                    @default(0)
  actualTrainees    Int                    @default(0)
  status            SessionStatus          @default(SCHEDULED)
  qrCodeToken       String?                @unique
  qrCodeGeneratedAt DateTime?
  // QR attendance window — QR is only active during this period
  qrActiveFrom      DateTime?
  qrActiveTo        DateTime?
  // ── Session-specific QR tokens for public exam/evaluation pages ──
  preTestQrToken       String?  @unique
  finalTestQrToken     String?  @unique
  evaluationQrToken    String?  @unique
  // Session lifecycle tracking
  lifecycleStatus   String                 @default("NOT_STARTED") // NOT_STARTED | STARTED | ON_BREAK | COMPLETED
  startedAt         DateTime?
  completedAt       DateTime?
  notes             String?
  // ── Trainer qualification exception ──
  // When a coordinator assigns a trainer who is NOT certified for the course,
  // these fields record the exception for audit purposes. This is a per-session
  // override — it does NOT grant the trainer permanent certification.
  trainerCertWaivedAt     DateTime?
  trainerCertWaivedBy     String?
  trainerCertWaiverReason String?
  // Import/export fields (course schedule sheet)
  instituteName     String? // اسم المعهد المنفذ
  classification    String                 @default("COURSE") // COURSE | EXAM — دورة / اختبار
  locationMapUrl    String? // احداثيات الموقع (map link)
  durationDays      Int? // مدة الدورة (days, as shown on the sheet)
  // Audit
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  createdBy         String?
  updatedBy         String?
  deletedAt         DateTime?

  attendance       Attendance[]
  checkInAttempts  CheckInAttempt[]
  testResults      TestResult[]
  examAttempts     ExamAttempt[]
  evaluations      CourseEvaluation[]
  certificates     Certificate[]
  lifecycleEvents  SessionLifecycleEvent[]
  enrollments      SessionEnrollment[]
  sessionCompanies SessionCompany[]
  sessionPayments  SessionPayment[]
  invoices         Invoice[]
  notificationLogs NotificationLog[]
  examSets        SessionExamSet[]
  claimItems      TrainerClaimItem[]

  @@index([status])
  @@index([trainerId])
  @@index([startDate])
  @@index([shift])
  @@index([city])
  @@index([requestCourseId])
  @@index([lifecycleStatus])
}

// Session lifecycle events: STARTED → BREAK → RESUMED → COMPLETED
model SessionLifecycleEvent {
  id        String          @id @default(uuid())
  sessionId String
  session   TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  eventType String // STARTED | BREAK | RESUMED | COMPLETED
  eventTime DateTime        @default(now())
  notes     String?
  // Audit
  createdAt DateTime        @default(now())
  createdBy String?

  @@index([sessionId])
  @@index([eventType])
}

model Attendance {
  id                    String          @id @default(uuid())
  sessionId             String
  session               TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  traineeName           String
  traineeIdNational     String?
  traineeEmail          String?
  traineePhone          String?
  company               String?
  companyId             String?
  checkInAt             DateTime?
  checkOutAt            DateTime?
  status                String          @default("REGISTERED") // REGISTERED | PRESENT | ABSENT | LATE | EXCUSED
  checkInMethod         String? // QR | MANUAL
  notes                 String?
  // Device tracking for QR check-in
  deviceInfo            String? // JSON: { userAgent, ipAddress, platform, deviceFingerprint }
  // Training execution progress (pipeline tracking)
  preTestAssignedAt     DateTime?
  preTestCompletedAt    DateTime?
  finalTestAssignedAt   DateTime?
  finalTestCompletedAt  DateTime?
  finalTestPassed       Boolean?
  evaluationCompletedAt DateTime?
  certificateEligible   Boolean         @default(false)
  certificateId         String?
  // Audit
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  createdBy             String?
  updatedBy             String?
  deletedAt             DateTime?

  examAttempts ExamAttempt[]

  @@index([sessionId])
  @@index([status])
  @@index([traineeIdNational])
  @@index([certificateEligible])
}

// Tracks every QR scan attempt (success + failures) — for analytics + fraud detection
model CheckInAttempt {
  id                String          @id @default(uuid())
  sessionId         String
  session           TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  qrToken           String?
  traineeName       String?
  traineeEmail      String?
  traineeIdNational String?
  ipAddress         String?
  userAgent         String?
  success           Boolean
  failureReason     String?
  attendedAt        DateTime        @default(now())

  @@index([sessionId])
  @@index([success])
}

// ─────────────────────────────────────────────────────────────────────────────
// EXAMS (Test Results) — EXAM-YYYY-000001
// ─────────────────────────────────────────────────────────────────────────────

model TestResult {
  id                String          @id @default(uuid())
  refNumber         String          @unique // EXAM-YYYY-000001
  sessionId         String
  session           TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  testType          TestType
  traineeName       String
  traineeEmail      String?
  traineeIdNational String?
  companyId         String? // trainee's original company — preserved for per-company reporting
  company           Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  scorePercent      Int
  passed            Boolean
  answers           String? // JSON of { questionId, selected }
  attemptedAt       DateTime        @default(now())
  durationSec       Int?
  // AI-assisted exam metadata
  questionSet       String? // JSON snapshot of question IDs presented (for AI exams)
  // Audit
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  createdBy         String?
  updatedBy         String?
  deletedAt         DateTime?

  @@index([sessionId, testType])
  @@index([traineeEmail])
  @@index([companyId])
}

// ─────────────────────────────────────────────────────────────────────────────
// EXAM ATTEMPTS — randomized per-trainee exam versions
// Each attempt has a unique question set (randomized order + randomized answer choices)
// ─────────────────────────────────────────────────────────────────────────────

model ExamAttempt {
  id                String          @id @default(uuid())
  refNumber         String          @unique // EXAM-YYYY-000001
  sessionId         String
  session           TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  attendanceId      String?
  attendance        Attendance?     @relation(fields: [attendanceId], references: [id], onDelete: SetNull)
  testType          TestType // PRE_TEST | FINAL_TEST
  traineeName       String
  traineeEmail      String?
  traineeIdNational String?
  companyId         String? // trainee's original company — preserved for per-company reporting
  company           Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  // Randomized exam version — snapshot of question IDs + their option ordering
  questionSet       String // JSON: [{ questionId, order, optionsOrder: [0,2,1,3] }]
  // Attempt state
  status            String          @default("ASSIGNED") // ASSIGNED | IN_PROGRESS | SUBMITTED | GRADED
  attemptNumber     Int             @default(1)
  maxAttempts       Int             @default(1)
  // Grading
  scorePercent      Int?
  passed            Boolean?
  passScore         Int? // snapshot of course.passScore at time of attempt
  // Timing
  assignedAt        DateTime        @default(now())
  startedAt         DateTime?
  submittedAt       DateTime?
  durationSec       Int?
  // Hard time limit for the exam: the attempt must be submitted by this moment.
  // Set when the trainee starts; the runner auto-submits when it is reached.
  deadline          DateTime?
  timedOut          Boolean         @default(false)
  // Answers — JSON: [{ questionId, selectedAnswerIndices: [...], correct: boolean }]
  answers           String?
  // Audit
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  createdBy         String?
  updatedBy         String?
  deletedAt         DateTime?

  @@index([sessionId, testType])
  @@index([attendanceId])
  @@index([status])
  @@index([traineeEmail])
  @@index([companyId])
}

// ─────────────────────────────────────────────────────────────────────────────
// SESSION EXAM QUESTION SET
// The trainer controls WHICH questions a session's exam uses. Generating a set
// draws a random sample from the course Question Bank (default: every active
// question for the test type). The trainer reviews the preview — including the
// correct answers beside each question — then Regenerates or Approves.
//
//   DRAFT  → generated but NOT yet accepted; the exam does NOT use it.
//   APPROVED → the session's exam uses exactly these questions (the engine only
//              ever reads the LATEST approved set; question + option order are
//              still randomized per trainee at attempt time).
//
// Nothing regenerates or replaces a set automatically — no cron, no timeout.
// Approving a new set simply creates a newer approved version; older versions
// are kept for audit and the Question Bank is never mutated.
// ─────────────────────────────────────────────────────────────────────────────

model SessionExamSet {
  id           String   @id @default(uuid())
  sessionId    String
  session      TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  testType     TestType // PRE_TEST | FINAL_TEST
  status       String   @default("DRAFT") // DRAFT | APPROVED
  version      Int      @default(1) // increments per generated set
  numQuestions Int      @default(0)
  // JSON array of question ids in the trainer-approved order. References the
  // bank — images (imageUrl) stay attached to the questions and keep working.
  questionIds  String
  // Audit
  approvedAt   DateTime?
  approvedBy   String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?

  @@index([sessionId, testType])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// COURSE EVALUATION
// ─────────────────────────────────────────────────────────────────────────────

model CourseEvaluation {
  id                String          @id @default(uuid())
  sessionId         String
  session           TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  trainerId         String?
  trainer           Trainer?        @relation(fields: [trainerId], references: [id])
  traineeName       String
  traineeEmail      String?
  traineeIdNational String?
  companyId         String? // trainee's original company — preserved for per-company reporting
  company           Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  attendanceId      String?
  trainerRating     Int
  contentRating     Int
  venueRating       Int
  materialsRating   Int
  overallRating     Int
  comments          String?
  suggestions       String? // Trainee's suggestions for improvement
  wouldRecommend    Boolean?
  submittedAt       DateTime        @default(now())
  // Audit
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  createdBy         String?
  updatedBy         String?
  deletedAt         DateTime?

  @@index([sessionId])
  @@index([trainerId])
  @@index([attendanceId])
  @@index([companyId])
}

// ─────────────────────────────────────────────────────────────────────────────
// CERTIFICATES + QR VERIFICATION
// ─────────────────────────────────────────────────────────────────────────────

model Certificate {
  id                String          @id @default(uuid())
  refNumber         String          @unique // CERT-YYYY-000001
  sessionId         String
  session           TrainingSession @relation(fields: [sessionId], references: [id])
  courseId          String
  course            Course          @relation(fields: [courseId], references: [id])
  companyId         String?
  company           Company?        @relation(fields: [companyId], references: [id])
  attendanceId      String? // link to attendance record that earned this certificate
  traineeName       String
  traineeIdNational String?
  traineeEmail      String?
  finalScore        Int
  issuedAt          DateTime        @default(now())
  validUntil        DateTime
  status            String          @default("VALID") // VALID | EXPIRED | REVOKED | RENEWED
  // ── Certificate Release Workflow ──
  // releaseStatus tracks the security workflow separately from validity status.
  // DRAFT → READY_FOR_RELEASE → RELEASED → DOWNLOADED
  releaseStatus       String          @default("DRAFT") // DRAFT | READY_FOR_RELEASE | RELEASED | DOWNLOADED
  releasedAt          DateTime?
  releasedBy          String?
  downloadedAt        DateTime?
  // ── Profession Verification (Iqama profession change) ──
  professionVerified   Boolean     @default(false)
  professionVerifiedAt DateTime?
  professionVerifiedBy String?
  professionVerificationNotes String?
  professionVerificationAttachmentUrl String?
  // Sprint 6: renewal chain
  renewedFromId     String?
  renewedFrom       Certificate?    @relation("CertRenewalChain", fields: [renewedFromId], references: [id], onDelete: SetNull)
  renewedBy         Certificate[]   @relation("CertRenewalChain")
  version           Int             @default(1) // 1 = original, 2+ = renewals
  renewedAt         DateTime?
  pdfUrl            String?
  pdfGeneratedAt    DateTime?
  // QR verification
  verificationToken String?         @unique
  qrCodeUrl         String?
  verificationCount Int             @default(0)
  lastVerifiedAt    DateTime?
  // Audit
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  createdBy         String?
  updatedBy         String?
  deletedAt         DateTime?

  verifications    CertificateVerification[]
  workerPassport   WorkerPassport?           @relation("WorkerPassportCertificates", fields: [workerPassportId], references: [id], onDelete: SetNull)
  workerPassportId String?

  @@index([sessionId])
  @@index([companyId])
  @@index([status])
  @@index([releaseStatus])
  @@index([verificationToken])
  @@index([attendanceId])
  @@index([renewedFromId])
  @@index([validUntil])
}
model CertificateVerification {
  id                String      @id @default(uuid())
  certificateId     String
  certificate       Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  verificationToken String?
  ipAddress         String?
  userAgent         String?
  countryCode       String?
  verifiedAt        DateTime    @default(now())

  @@index([certificateId])
  @@index([verifiedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// WORKER TRAINING PASSPORT & COMPLIANCE MATRIX (Sprint 6)
// ─────────────────────────────────────────────────────────────────────────────

// One permanent digital passport per worker, keyed by National ID / Iqama.
// Auto-generated when a certificate is first issued to a trainee whose
// nationalId isn't yet linked to a passport. The worker does NOT create or
// edit the passport — it is purely system-managed.
model WorkerPassport {
  id             String    @id @default(uuid())
  passportNumber String    @unique // WP-YYYY-NNNNNN
  nationalId     String    // National ID / Iqama
  fullName       String
  companyId      String
  company        Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  jobTitle       String?
  mobile         String?
  email          String?
  // QR code — separate from certificate QR. Points to /worker/{qrToken}
  qrToken        String    @unique @default(uuid())
  qrCodeUrl      String?
  // Audit
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?

  // Relations
  certificates Certificate[] @relation("WorkerPassportCertificates")

  @@unique([nationalId, companyId])
  @@index([nationalId])
  @@index([companyId])
  @@index([qrToken])
  @@index([passportNumber])
}

// Compliance Rule — admin-configurable mandatory course requirements.
// Each rule maps a Course to a scope (All Workers / Company / Job Title / Project / Client).
model ComplianceRule {
  id              String    @id @default(uuid())
  courseId        String
  course          Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  isMandatory     Boolean   @default(true) // mandatory vs. recommended
  isCoreMandatory Boolean   @default(false) // OHS/Fire Safety/First Aid — only SUPER_ADMIN can disable
  validityMonths  Int       @default(24) // override course.validityMonths if set
  // Scope: who does this rule apply to?
  scopeType       String    @default("ALL") // ALL | COMPANY | JOB_TITLE | PROJECT | CLIENT
  scopeValue      String? // company ID, job title string, project name, or client name
  scopeLabel      String? // human-readable: "Acme Co." or "Electrician" or "Project X"
  isActive        Boolean   @default(true)
  // Audit
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?

  versions ComplianceRuleVersion[]

  @@index([courseId])
  @@index([scopeType])
  @@index([isActive])
  @@index([scopeType, scopeValue])
}

// Immutable audit trail for every compliance rule change.
// Never deleted — full history of who changed what, when, and why.
model ComplianceRuleVersion {
  id              String         @id @default(uuid())
  ruleId          String
  rule            ComplianceRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  version         Int            @default(1)
  // Snapshot of the rule at this version
  courseId        String
  isMandatory     Boolean
  isCoreMandatory Boolean
  validityMonths  Int
  scopeType       String
  scopeValue      String?
  scopeLabel      String?
  isActive        Boolean
  // Change metadata
  changedBy       String
  changedAt       DateTime       @default(now())
  changeType      String // CREATE | UPDATE | ACTIVATE | DEACTIVATE
  reason          String? // optional reason for the change
  // Before/after diff (JSON)
  previousValues  String? // JSON string of previous field values

  @@index([ruleId])
  @@index([changedAt])
  @@index([changeType])
}

// ─────────────────────────────────────────────────────────────────────────────
// NOTIFICATIONS (multi-channel: in-app, email, push, SMS — future mobile)
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id          String    @id @default(uuid())
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  title       String
  titleAr     String?
  message     String
  messageAr   String?
  type        String    @default("INFO") // INFO | SUCCESS | WARNING | ERROR | REQUEST
  category    String    @default("SYSTEM") // SYSTEM | REQUEST | SESSION | CERTIFICATE | TEST
  link        String?
  isRead      Boolean   @default(false)
  readAt      DateTime?
  // Multi-channel support
  channels    String? // JSON: ["in_app", "email", "push", "sms"]
  emailSentAt DateTime?
  pushSentAt  DateTime?
  // Audit
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, isRead])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// NOTIFICATION DELIVERY LOG — per-channel send ledger
// =====================================================================
// Records every delivery attempt made by the Notification Service, one row per
// (type, reference, company, channel). The Notification row is the in-app inbox
// item; NotificationLog is the delivery ledger behind it (Email/WhatsApp/SMS).
//
// The @@unique on (type, referenceId, companyId, channel) is the duplicate
// guard: a cron that fires twice can never create a second row for the same
// reminder, and the service refuses to re-send a channel already marked SENT.
// Each channel is tracked independently, so one channel failing never blocks
// the others.
//
// Type values are extensible — SESSION_REMINDER_24H today, future types
// (SESSION_RESCHEDULED, SESSION_CANCELLED, SESSION_REMINDER_2H, …) reuse the
// same ledger without schema changes.
// ─────────────────────────────────────────────────────────────────────────────

model NotificationLog {
  id             String    @id @default(uuid())
  type           String    @default("SESSION_REMINDER_24H")
  referenceType  String    @default("SESSION") // SESSION | CERTIFICATE | REQUEST | …
  referenceId    String // e.g. the session id — required, part of the dedupe key
  companyId      String?
  company        Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  sessionId      String?
  session        TrainingSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  channel        String    @default("EMAIL") // EMAIL | WHATSAPP | SMS
  recipientName  String?
  recipientValue String? // email address or phone number the message went to
  language       String    @default("en") // template language used
  scheduledAt    DateTime? // when the reminded event starts (session start time)
  sentAt         DateTime?
  status         String    @default("PENDING") // PENDING | SENT | FAILED
  errorMessage   String?
  messageId      String? // provider message id when the provider returns one
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@unique([type, referenceId, companyId, channel])
  @@index([type])
  @@index([referenceId])
  @@index([companyId])
  @@index([status])
  @@index([scheduledAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// SESSION PAYMENT — lightweight invoice tracking for certificate release
// =====================================================================
// Tracks the total amount owed by a company for a training session and the
// amount paid so far. The certificate release workflow checks that the
// session payment is fully paid (paidAmount >= totalAmount) before
// allowing certificates to be released to the contractor.
//
// One record per (sessionId, companyId) — a session may have multiple
// companies enrolled, each with their own payment obligation.
// ─────────────────────────────────────────────────────────────────────────────

model SessionPayment {
  id              String   @id @default(uuid())
  sessionId       String
  session         TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  // Financial amounts (in the currency specified below)
  totalAmount     Float    @default(0)
  paidAmount      Float    @default(0)
  currency        String   @default("SAR")
  // Invoice reference (optional — for linking to external invoice numbers)
  invoiceRef      String?
  invoiceIssuedAt DateTime?
  invoiceDueDate  DateTime?
  // Status derived from paidAmount / totalAmount: UNPAID | PARTIALLY_PAID | PAID
  notes           String?
  // ── Payment verification workflow ──
  // PENDING → PARTIALLY_VERIFIED → VERIFIED | REJECTED
  verificationStatus String    @default("PENDING")
  verifiedBy         String?
  verifiedAt         DateTime?
  verificationNotes  String?
  // Coordinator grants certificate printing permission after full payment.
  printingReleased   Boolean   @default(false)
  printingReleasedBy String?
  printingReleasedAt DateTime?
  // Audit
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?

  receipts        PaymentReceipt[]

  @@unique([sessionId, companyId])
  @@index([sessionId])
  @@index([companyId])
  @@index([invoiceRef])
}

// ── Payment Receipts ──────────────────────────────────────────────────────
// Uploaded by contractors as proof of bank transfer. Reviewed by coordinators
// who verify the amount and update the SessionPayment's paidAmount.
model PaymentReceipt {
  id               String    @id @default(uuid())
  sessionPaymentId String
  filename         String
  originalName     String
  url              String
  amount           Float
  currency         String    @default("SAR")
  // PENDING → VERIFIED | REJECTED
  status           String    @default("PENDING")
  uploadedById     String?
  uploadedAt       DateTime  @default(now())
  verifiedById     String?
  verifiedAt       DateTime?
  rejectionReason  String?
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  sessionPayment   SessionPayment @relation(fields: [sessionPaymentId], references: [id], onDelete: Cascade)

  @@index([sessionPaymentId])
  @@index([status])
}

// ── Retest Management ────────────────────────────────────────────────────
// Tracks the full lifecycle of a retest when a trainee fails the final
// assessment. Linked to the original enrollment (NOT a new request) so the
// trainee's history stays in one place.
model RetestRequest {
  id                 String    @id @default(uuid())
  refNumber          String    @unique
  enrollmentId       String
  sessionId          String
  courseId           String
  traineeName        String
  traineeIdNational  String?
  companyId          String?
  // Distinguishes between a Trainer Immediate Opportunity (same session,
  // no notification, no official retest) and an Official Retest (full
  // workflow with contractor notifications + scheduling).
  retestType         String    @default("OFFICIAL") // "TRAINER_OPPORTUNITY" | "OFFICIAL"
  // The session where the retest will take place. Can be the same session
  // (retest in-place) or a different one (moved to another session).
  retestSessionId    String?
  retestTrainerId    String?
  retestDate         DateTime?
  retestShift        String?
  retestLocation     String?
  retestVenue        String?
  // PENDING_RETEST → SCHEDULED → RESCHEDULED → COMPLETED | CANCELLED
  status             String    @default("PENDING_RETEST")
  // The exam attempt that triggered this retest (the failed one).
  failedAttemptId    String?
  // The exam attempt created for this retest (the new one).
  retestAttemptId    String?
  // Result of the retest: null = not yet taken, true = passed, false = failed
  passed             Boolean?
  reason             String?
  scheduledBy        String?
  scheduledAt        DateTime?
  cancelledBy        String?
  cancelledAt        DateTime?
  cancellationReason String?
  // Audit
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  createdBy          String?
  updatedBy          String?
  deletedAt          DateTime?

  @@index([enrollmentId])
  @@index([sessionId])
  @@index([status])
  @@index([companyId])
  @@index([retestType])
}

// ─────────────────────────────────────────────────────────────────────────────
// AUDIT LOG — captures every required action automatically
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id            String   @id @default(uuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action        String // LOGIN | LOGOUT | FAILED_LOGIN | CREATE | UPDATE | DELETE | APPROVE | REJECT | ISSUE_CERT | RENEW_CERT | GENERATE_QR | VERIFY_QR | CREATE_WORKER | UPDATE_WORKER | DELETE_WORKER | CREATE_COMPANY | UPDATE_COMPANY | COMPLIANCE_CHANGE | PERMISSION_CHANGE | STATUS_CHANGE | EXAM_SUBMIT | CERTIFICATE_GENERATE | ISSUE | REVOKE | QR_REGENERATE | EXPORT
  entity        String // COMPANY | TRAINER | TRAINEE | COURSE | REQUEST | SESSION | CERTIFICATE | USER | ROLE | SETTING | EXAM | ATTENDANCE | EVALUATION | WORKER_PASSPORT | COMPLIANCE_RULE | QR_CODE
  entityId      String?
  entityRef     String? // human-readable ref number (TR-..., CERT-..., etc.)
  description   String
  descriptionAr String?
  ipAddress     String?
  userAgent     String?
  // Sprint 6: Enterprise Audit Trail — extended fields
  userRole      String? // role of the user at time of action
  browser       String? // parsed from UA
  device        String? // parsed from UA
  oldValue      String? // JSON: previous field values (for UPDATE/DELETE)
  newValue      String? // JSON: new field values (for CREATE/UPDATE)
  reason        String? // optional reason for the action
  metadata      String? // JSON: before/after diff for UPDATE, old/new status for STATUS_CHANGE
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([action])
  @@index([createdAt])
  @@index([ipAddress])
}

// ─────────────────────────────────────────────────────────────────────────────
// SCHEDULED REPORTS — automated report generation + email delivery
// =====================================================================
// ReportSchedule defines what report to generate, when, for whom, and
// where to email it. ReportExecution logs every run with delivery status.
// ─────────────────────────────────────────────────────────────────────────────

model ReportSchedule {
  id              String    @id @default(uuid())
  name            String
  nameAr          String?
  description     String?
  // Template
  templateCode    String // e.g. "GCCLAB_MONTHLY"
  // Schedule type
  scheduleType    String // WEEKLY | MONTHLY | DAILY | CUSTOM
  // Cron expression for flexible scheduling (e.g. "0 9 * * 4" = every Thursday 9am)
  cronExpression  String // standard 5-field cron
  // Configurable execution time
  executionTime   String? // "HH:mm" (24h, e.g. "09:00") — used for display + default
  timezone        String    @default("Asia/Riyadh")
  // Day of week (0=Sun, 4=Thu) — for WEEKLY type
  dayOfWeek       Int? // 0-6
  // Day of month (1-31) — for MONTHLY type
  dayOfMonth      Int? // 1-31
  // Filters — JSON object passed to the template query
  filters         String? // JSON: { month, companyId, region, city, ... }
  // Export format
  exportFormats   String    @default("xlsx") // JSON: ["xlsx", "pdf"]
  // Email recipients — JSON array of email addresses
  recipients      String // JSON: ["email1@example.com", "email2@example.com"]
  ccRecipients    String? // JSON: ["cc1@example.com"]
  bccRecipients   String? // JSON: ["bcc1@example.com"]
  emailSubject    String?
  emailBody       String?
  // Status
  isActive        Boolean   @default(true)
  // Tracking
  lastRunAt       DateTime?
  nextRunAt       DateTime?
  lastExecutionId String?
  // Retry config
  maxRetries      Int       @default(3)
  retryDelayMin   Int       @default(10) // minutes between retries
  // Audit
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?

  executions ReportExecution[]

  @@index([isActive])
  @@index([nextRunAt])
  @@index([scheduleType])
}

model ReportExecution {
  id              String         @id @default(uuid())
  scheduleId      String
  schedule        ReportSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  // Execution details
  status          String         @default("PENDING")
  // PENDING | RUNNING | GENERATING | SENDING | SENT | COMPLETED | FAILED | RETRYING
  // | SUPERSEDED | CANCELLED
  // COMPLETED  = report generated and stored, but nothing was emailed (SMTP not configured)
  // SUPERSEDED = a retry produced a newer execution that replaces this one
  triggerType     String         @default("SCHEDULED") // SCHEDULED | MANUAL
  triggeredBy     String? // user id (for MANUAL)
  // Report data
  templateCode    String
  rowCount        Int?
  filterSummary   String? // JSON: actual filter used
  // Export files — JSON: [{ format, filename, sizeBytes }]
  exportedFiles   String?
  // Email delivery
  emailStatus     String? // PENDING | SENT | FAILED | SKIPPED | SIMULATED
  // SIMULATED = SMTP is not configured; the send was logged, not performed.
  // This exists because the email service used to report success in that case and
  // the row was written as SENT, so the UI claimed reports had been delivered.
  emailSentAt     DateTime?
  emailError      String?
  emailRecipients String? // actual recipients used
  // Retry tracking
  attemptNumber   Int            @default(1)
  maxRetries      Int            @default(3)
  nextRetryAt     DateTime?
  // Timing
  startedAt       DateTime       @default(now())
  completedAt     DateTime?
  durationMs      Int?
  // Error
  errorMessage    String?
  errorStack      String?
  // Audit
  createdAt       DateTime       @default(now())

  files ReportExecutionFile[]

  @@index([scheduleId])
  @@index([status])
  @@index([createdAt])
  @@index([emailStatus])
}

// Generated report files, stored as blobs.
//
// The execution engine used to build the xlsx/pdf buffers, record their sizes in
// ReportExecution.exportedFiles, and then let them be garbage collected — there was no
// storage column and no download route, so a "successful" scheduled report produced
// nothing a human could ever obtain.
//
// A separate table rather than columns on ReportExecution: Prisma has no column-level
// lazy loading, so a `content Bytes` on the execution row would be pulled into memory by
// the executions list query unless every single caller remembered to `select` around it.
model ReportExecutionFile {
  id          String          @id @default(uuid())
  executionId String
  execution   ReportExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  format      String // xlsx | pdf
  filename    String
  mimeType    String
  sizeBytes   Int
  content     Bytes // BLOB on SQLite
  checksum    String? // sha256 hex
  expiresAt   DateTime?
  createdAt   DateTime        @default(now())

  @@index([executionId])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// FINANCIAL MODULE — Invoice, Payment, Quotation, Receipt, BankAccount, Settings
// =====================================================================
// Full financial workflow: Quotation → Invoice → Payment → Receipt
// All amounts stored as Float. Snapshot field on Invoice captures frozen
// company/bank/settings info at issue time.
// ─────────────────────────────────────────────────────────────────────────────

model FinancialSettings {
  id              String   @id @default("default")
  companyName     String   @default("GCC ELECTRICAL TESTING LABORATORY")
  crNumber        String?
  vatNumber       String?
  financeEmail    String?
  companyLogoUrl  String?
  address         String?
  phone           String?
  currency        String   @default("SAR")
  invoiceSeq      Int      @default(1)
  quotationSeq    Int      @default(1)
  receiptSeq      Int      @default(1)
  vatRate         Float    @default(15)
  defaultDueDays  Int      @default(30)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  updatedBy       String?
}

// ─────────────────────────────────────────────────────────────────────────────
// TRAINER CLAIMS — Overtime + Business Mission / Daily Allowance
// ─────────────────────────────────────────────────────────────────────────────
// Claims are computed from Training Sessions (the single source of truth): no
// manual re-entry of session data, no duplicate session records. A claim is one
// trainer × one claim type × one month period, generated from the sessions that
// fall inside the period, then reviewed/adjusted by the trainer and approved by
// the coordinator. Approved claims are snapshotted: item values, rates, totals
// and settings are stored on the claim rows, so a later settings change or a
// session edit never silently rewrites an approved claim.

// Claim configuration with effective-date history. The current value is the row
// with the latest effectiveFrom <= now. Every change inserts a NEW row — old rows
// are never updated — so a claim always records which rate was in force when it
// was generated/approved.
model ClaimSetting {
  id            String   @id @default(uuid())
  key           String // MAIN_LOCATION | EMPLOYEE_DAILY_ALLOWANCE | CONTRACTOR_DAILY_ALLOWANCE
  value         String
  effectiveFrom DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedBy     String?
  description   String?

  @@index([key, effectiveFrom])
}

model TrainerClaim {
  id             String   @id @default(uuid())
  refNumber      String   @unique // CL-YYYY-000001 (yearly)
  claimType      String // OVERTIME | BUSINESS_MISSION
  trainerId      String
  trainer        Trainer  @relation(fields: [trainerId], references: [id])
  engagementType String // EMPLOYEE | CONTRACTOR — snapshot at generation, never re-read later
  periodFrom     DateTime
  periodTo       DateTime
  status         String   @default("DRAFT") // DRAFT | GENERATED | SUBMITTED | PENDING_COORDINATOR_APPROVAL | RETURNED | REJECTED | APPROVED | FINAL
  // Coordinator routing — the trainer nominates the coordinator who assigned them.
  coordinatorId  String?  // User.id of the nominated/referring coordinator
  coordinator    User?    @relation("ClaimCoordinator", fields: [coordinatorId], references: [id], onDelete: SetNull)
  // Configuration snapshot at generation (business mission rates / main location).
  dailyAllowance Float? // SAR/day used for BUSINESS_MISSION rows (employee or contractor rate)
  mainLocation   String? // main work location used for BUSINESS_MISSION qualification
  // Workflow actors + timestamps
  generatedAt    DateTime?
  generatedBy    String?
  submittedAt    DateTime?
  submittedBy    String?
  approvedAt     DateTime?
  approvedBy     String?
  returnedAt     DateTime?
  returnedBy     String?
  returnReason   String?
  finalizedAt    DateTime?
  finalizedBy    String?
  notes          String?
  // HRD-FO-052 Employee Overtime fields
  employeeId              String? // Employee ID (HR code)
  employeeJobTitle        String? // Job Title snapshot
  employeeDepartment      String? // Department / Company snapshot
  employeeProject         String? // Project / Work Location snapshot
  employeeLineManager     String? // Line Manager name snapshot
  normalWorkingHoursPerDay Float?  // e.g. 8
  estimatedOtPerDay       Float?  // e.g. 4
  requestedBy             String? // EMPLOYEE_REQUEST | OPERATIONAL_REQUIREMENT | OTHER
  reason                  String? // Reason for extended overtime
  // Employee Acknowledgment
  acknowledgmentAccepted  Boolean @default(false)
  acknowledgmentText      String? // The full legal acknowledgment text snapshot
  // Line Manager Review & Approval (HRD-FO-052 Section 4)
  lineManagerDecision     String? // APPROVED | APPROVED_WITH_CONDITIONS | NOT_APPROVED
  lineManagerChecklist    String? // JSON: { workloadReviewed, restPeriods, budgetConfirmed, ... }
  lineManagerComments     String?
  lineManagerSignatureBy  String?
  lineManagerSignatureAt  DateTime?
  // QHSE Review (HRD-FO-052 Section 5)
  qhseAssessment          String? // ACCEPTABLE | ACCEPTABLE_WITH_CONTROLS | FURTHER_ASSESSMENT | NOT_RECOMMENDED
  qhseControls            String?
  qhseSignatureBy         String?
  qhseSignatureAt         DateTime?
  // HR Review (HRD-FO-052 Section 6)
  hrDecision              String? // APPROVED | APPROVED_WITH_CONDITIONS | NOT_APPROVED
  hrMaxApprovedOt         Float?
  hrApprovedPeriodFrom    DateTime?
  hrApprovedPeriodTo      DateTime?
  hrSignatureBy           String?
  hrSignatureAt           DateTime?
  hrComments              String?
  // Contractor / Consultant Invoice fields
  contractorInvoiceNumber String? // Invoice #
  contractorClient        String? // Client name
  contractorRatePerDay    Float?  // SAR/day
  // JSON array of lifecycle events: { at, by, action, detail? }. Kept for the
  // claim detail view; the global AuditLog stays the authoritative audit source.
  history        String?
  // Summaries (recomputed on generate, frozen on approve/finalize)
  totalHours     Float    @default(0) // OT hours (employee) / regular hours (contractor)
  totalDays      Int      @default(0) // business mission qualifying days
  totalAmount    Float    @default(0) // business mission SAR total
  currency       String   @default("SAR")
  // Audit
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?

  items TrainerClaimItem[]

  @@unique([trainerId, claimType, periodFrom, deletedAt])
  @@index([trainerId])
  @@index([coordinatorId])
  @@index([claimType])
  @@index([status])
  @@index([periodFrom])
}

model TrainerClaimItem {
  id               String        @id @default(uuid())
  claimId          String
  claim            TrainerClaim  @relation(fields: [claimId], references: [id], onDelete: Cascade)
  sessionId        String
  session          TrainingSession @relation(fields: [sessionId], references: [id])
  date             DateTime // the training day this row covers (session.startDate or a day inside a multi-day session)
  // Snapshots — an approved claim stays readable even if the course/trainer changes later.
  courseCode       String?
  courseTitle      String?
  location         String? // session city/location snapshot (the claim location shown on the sheet)
  locationFlagged  Boolean       @default(false) // location missing/ambiguous → needs review
  flagReason       String?
  shift            String? // MORNING | EVENING (or "M/E" rendered by the export)
  actualHours      Float         @default(0) // the session's duration for that day
  // Calculated from the engine (OT daily cap / BM 1 day). Never overwritten after
  // generation — manual edits live in adjustedValue and preserve this original.
  originalValue    Float
  adjustedValue    Float? // manual override by the trainer; final uses this when set
  adjustmentReason String?
  adjustedBy       String?
  adjustedAt       DateTime?
  finalValue       Float // adjustedValue ?? originalValue — locked once approved
  unit             String // "HOURS" | "DAYS"
  rate             Float? // business mission daily allowance snapshot (SAR/day); null for OT
  amount           Float? // business mission: finalValue × rate; null for OT
  included         Boolean       @default(true)
  createdBy        String?
  updatedAt        DateTime      @updatedAt

  @@index([claimId])
  @@index([sessionId])
  @@index([date])
}

model BankAccount {
  id              String   @id @default(uuid())
  bankName        String
  beneficiary     String
  accountNumber   String
  iban            String?
  swift           String?
  qrImageUrl      String?
  isActive        Boolean  @default(true)
  isDefault       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?
  invoices        Invoice[]
  @@index([isActive])
}

model Quotation {
  id              String   @id @default(uuid())
  refNumber       String   @unique
  requestId       String?
  request         TrainingRequest? @relation(fields: [requestId], references: [id])
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  lineItems       String
  subtotal        Float
  discountAmount  Float    @default(0)
  discountPercent Float?
  vatAmount       Float
  grandTotal      Float
  currency        String   @default("SAR")
  vatRate         Float
  status          String   @default("DRAFT")
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?
  invoices        Invoice[]
  @@index([companyId])
  @@index([requestId])
  @@index([status])
}

model Invoice {
  id              String   @id @default(uuid())
  refNumber       String   @unique
  quotationId     String?
  quotation       Quotation? @relation(fields: [quotationId], references: [id])
  requestId       String?
  request         TrainingRequest? @relation(fields: [requestId], references: [id])
  sessionId       String?
  session         TrainingSession? @relation(fields: [sessionId], references: [id])
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  lineItems       String
  subtotal        Float
  discountAmount  Float    @default(0)
  discountPercent Float?
  vatAmount       Float
  grandTotal      Float
  paidAmount      Float    @default(0)
  outstandingBalance Float
  currency        String   @default("SAR")
  vatRate         Float
  status          String   @default("DRAFT")
  issueDate       DateTime @default(now())
  dueDate         DateTime?
  paidDate        DateTime?
  bankAccountId   String?
  bankAccount     BankAccount? @relation(fields: [bankAccountId], references: [id])
  coordinatorNotes String?
  paymentNotes    String?
  snapshot        String
  pdfUrl          String?
  pdfGeneratedAt  DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?
  payments        Payment[]
  receipts        Receipt[]
  paymentInvoices PaymentInvoice[]
  @@index([companyId])
  @@index([requestId])
  @@index([sessionId])
  @@index([status])
  @@index([issueDate])
  @@index([dueDate])
}

model Payment {
  id              String   @id @default(uuid())
  refNumber       String   @unique
  invoiceId       String?
  invoice         Invoice? @relation(fields: [invoiceId], references: [id])
  paymentInvoices PaymentInvoice[]
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  amount          Float
  vatAmount       Float    @default(0)
  currency        String   @default("SAR")
  method          String
  status          String   @default("PENDING")
  paymentDate     DateTime @default(now())
  referenceNumber String?
  bankAccountId   String?
  paidBy          String?
  gatewayTransactionId String?
  gatewayName     String?
  gatewayResponse String?
  gatewayCallbackUrl String?
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?
  receipts        Receipt[]
  @@index([invoiceId])
  @@index([companyId])
  @@index([status])
}

model PaymentInvoice {
  id          String  @id @default(uuid())
  paymentId   String
  payment     Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  amount      Float
  @@index([paymentId])
  @@index([invoiceId])
}

model Receipt {
  id              String   @id @default(uuid())
  refNumber       String   @unique
  paymentId       String?
  payment         Payment? @relation(fields: [paymentId], references: [id])
  invoiceId       String?
  invoice         Invoice? @relation(fields: [invoiceId], references: [id])
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  amount          Float
  vatAmount       Float    @default(0)
  currency        String   @default("SAR")
  receiptDate     DateTime @default(now())
  paymentMethod   String?
  paidBy          String?
  bankName        String?
  referenceNumber String?
  status          String   @default("ISSUED")
  pdfUrl          String?
  pdfGeneratedAt  DateTime?
  snapshot        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?
  @@index([paymentId])
  @@index([invoiceId])
  @@index([companyId])
  @@index([receiptDate])
}

// ── ImportExportLog ────────────────────────────────────────────────────────
// Personal operation history for the Import/Export dialogs. NOT an audit
// log — just a quick "recent operations" list for the user's convenience.
model ImportExportLog {
  id          String   @id @default(uuid())
  userId      String
  type        String   // "IMPORT" | "EXPORT"
  source      String   // "DEVICE" | "ARCHIVE" | "EXPORT"
  requestRef  String?
  courseName  String?
  itemCount   Int      @default(0)
  status      String   @default("SUCCESS") // "SUCCESS" | "FAILED"
  errorMessage String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}
