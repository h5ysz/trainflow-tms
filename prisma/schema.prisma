model CompanyContact {
  id               String    @id @default(uuid())
  companyId        String
  fullName         String
  jobTitle         String? // Position
  email            String?
  phone            String?
  mobile           String?
  preferredContact String? // PHONE | MOBILE | EMAIL | WHATSAPP
  isPrimary        Boolean   @default(false)
  isActive         Boolean   @default(true)
  notes            String?
  // Audit
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        String?
  updatedBy        String?
  deletedAt        DateTime?

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

// ─────────────────────────────────────────────────────────────────────────────
// TRAINERS & QUALIFICATIONS
// ─────────────────────────────────────────────────────────────────────────────

model Trainer {
  id          String    @id @default(uuid())
  refNumber   String    @unique // TRN-000001
  fullName    String
  fullNameAr  String?
  nationalId  String?   @unique
  email       String?   @unique
  phone       String?
  mobile      String?
  gender      String?
  nationality String?
  country     String?
  city        String?
  address     String?
  bio         String?
  photoUrl    String?
  status      String    @default("ACTIVE")
  hireDate    DateTime?
  tenantId    String?
  // Audit
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?

  tenant         Tenant?                @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  qualifications TrainerQualification[]
  certifications TrainerCertification[]
  user           User?
  sessions       TrainingSession[]
  evaluations    CourseEvaluation[]

  @@index([status])
  @@index([tenantId])
}

model TrainerQualification {
  id               String    @id @default(uuid())
  trainerId        String
  title            String
  issuer           String?
  credentialNumber String?
  issueDate        DateTime?
  expiryDate       DateTime?
  documentUrl      String?
  status           String    @default("VALID") // VALID | EXPIRED | EXPIRING_SOON
  // Audit
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  createdBy        String?
  updatedBy        String?
  deletedAt        DateTime?

  trainer        Trainer                @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  certifications TrainerCertification[]

  @@index([trainerId])
  @@index([status])
}

// Trainer-Course certification link — a trainer can only teach courses they're certified for
model TrainerCertification {
  id              String    @id @default(uuid())
  trainerId       String
  courseId        String
  qualificationId String? // optional link to source qualification
  validFrom       DateTime  @default(now())
  validUntil      DateTime?
  status          String    @default("VALID") // VALID | EXPIRED | REVOKED
  notes           String?
  // Audit
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?

  trainer       Trainer               @relation(fields: [trainerId], references: [id], onDelete: Cascade)
  course        Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  qualification TrainerQualification? @relation(fields: [qualificationId], references: [id], onDelete: SetNull)

  @@unique([trainerId, courseId, deletedAt])
  @@index([trainerId])
  @@index([courseId])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// COURSES (catalog) + QUESTION BANK
// ─────────────────────────────────────────────────────────────────────────────

model Course {
  id             String    @id @default(uuid())
  refNumber      String    @unique // CRS-000001
  code           String    @unique
  title          String
  titleAr        String?
  description    String?
  category       String?
  durationHours  Int       @default(8)
  language       String    @default("en")
  validityMonths Int       @default(12)
  passScore      Int       @default(70)
  maxTrainees    Int       @default(20)
  hasPreTest     Boolean   @default(true)
  hasFinalTest   Boolean   @default(true)
  hasEvaluation  Boolean   @default(true)
  status         String    @default("ACTIVE")
  tenantId       String?
  // AI-assisted exam support
  aiExamEnabled  Boolean   @default(false)
  aiExamConfig   String? // JSON: difficulty distribution, num questions, etc.
  // Audit
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?

  tenant                Tenant?                 @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  requests              TrainingRequest[]
  requestCourses        TrainingRequestCourse[]
  sessions              TrainingSession[]
  questions             Question[]
  certificates          Certificate[]
  trainerCertifications TrainerCertification[]
  complianceRules       ComplianceRule[]
  resources             CourseResource[]

  @@index([status])
  @@index([category])
  @@index([tenantId])
}

// Sprint 6: Course Resources — external materials (PDF, PPT, URL, QR link)
model CourseResource {
  id          String   @id @default(uuid())
  courseId    String
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  type        String   // "PDF" | "POWERPOINT" | "URL" | "QR_CODE"
  title       String
  titleAr     String?
  url         String
  description String?
  order       Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?

  @@index([courseId])
  @@index([type])
}

// Question Bank — questions can be course-specific OR shared in the bank
model Question {
  id             String         @id @default(uuid())
  courseId       String? // nullable → bank-only question
  course         Course?        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  type           QuestionType   @default(SINGLE_CHOICE)
  testType       TestType       @default(PRE_TEST)
  text           String
  textAr         String?
  options        String // JSON array of strings
  correctAnswers String // JSON array of indices
  points         Int            @default(1)
  order          Int            @default(0)
  isActive       Boolean        @default(true)
  // Question bank metadata
  category       String? // tag for bank browsing
  difficulty     String         @default("MEDIUM") // EASY | MEDIUM | HARD
  tags           String? // JSON array of tags
  // AI-assisted exam support
  source         QuestionSource @default(MANUAL)
  aiGeneratedAt  DateTime?
  aiModel        String?
  aiPrompt       String?
  // Audit
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?

  @@index([courseId, testType])
  @@index([category])
  @@index([difficulty])
}

// ─────────────────────────────────────────────────────────────────────────────
// TRAINING REQUESTS (workflow: DRAFT → SUBMITTED → UNDER_REVIEW → APPROVED → SCHEDULED → IN_PROGRESS → COMPLETED | CANCELLED | REJECTED)
// ─────────────────────────────────────────────────────────────────────────────

model TrainingRequest {
  id                String                @id @default(uuid())
  refNumber         String                @unique // TR-YYYY-000001
  companyId         String
  courseId          String? // optional primary course (legacy single-course field)
  requestedBy       String? // user id
  traineeCount      Int                   @default(0) // total across all courses
  preferredDateFrom DateTime?
  preferredDateTo   DateTime?
  preferredLocation String?
  preferredLanguage String?
  notes             String?
  status            TrainingRequestStatus @default(DRAFT)
  priority          String                @default("NORMAL") // LOW | NORMAL | HIGH | URGENT
  rejectionReason   String?
  approvedAt        DateTime?
  approvedBy        String?
  submittedAt       DateTime?
  reviewedAt        DateTime?
  scheduledAt       DateTime?
  startedAt         DateTime?
  completedAt       DateTime?
  cancelledAt       DateTime?
  rejectedAt        DateTime?
  // Audit
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  createdBy         String?
  updatedBy         String?
  deletedAt         DateTime?

  company        Company                 @relation(fields: [companyId], references: [id])
  course         Course?                 @relation(fields: [courseId], references: [id])
  sessions       TrainingSession[]
  requestCourses TrainingRequestCourse[]
  // Financial module
  quotations     Quotation[]
  invoices       Invoice[]

  @@index([status])
  @@index([companyId])
  @@index([courseId])
}

// Junction: a Training Request contains multiple courses, each with its own trainee list
// Business rules: minTrainees=10, maxTrainees=20 per course
model TrainingRequestCourse {
  id           String    @id @default(uuid())
  requestId    String
  courseId     String
  traineeCount Int       @default(0)
  minTrainees  Int       @default(10) // business rule: minimum 10
  maxTrainees  Int       @default(20) // business rule: maximum 20
  notes        String?
  // Audit
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  createdBy    String?
  updatedBy    String?
  deletedAt    DateTime?

  request  TrainingRequest                @relation(fields: [requestId], references: [id], onDelete: Cascade)
  course   Course                         @relation(fields: [courseId], references: [id])
  trainees TrainingRequestCourseTrainee[]
  sessions TrainingSession[]

  @@unique([requestId, courseId, deletedAt])
  @@index([requestId])
  @@index([courseId])
}

// Junction: trainees assigned to a specific course within a training request
model TrainingRequestCourseTrainee {
  id              String    @id @default(uuid())
  requestCourseId String
  traineeId       String
  // Audit
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?

  requestCourse TrainingRequestCourse @relation(fields: [requestCourseId], references: [id], onDelete: Cascade)
  trainee       Trainee               @relation(fields: [traineeId], references: [id], onDelete: Cascade)

  @@unique([requestCourseId, traineeId])
  @@index([requestCourseId])
  @@index([traineeId])
}

// ─────────────────────────────────────────────────────────────────────────────
// MULTI-COMPANY SESSION ENROLLMENT — CENTRAL WORKFLOW ENTITY
// =====================================================================
// SessionEnrollment is the single source of truth for every trainee's
// progress inside a Training Session. It tracks the complete lifecycle:
//
//   Enrollment → Attendance → Pre-Test → Session Lifecycle → Final-Test
//     → Evaluation → Certificate
//
// All downstream modules (Attendance, ExamAttempt, CourseEvaluation,
// Certificate) automatically update these status fields via sync functions.
//
// A Training Session can contain trainees from MULTIPLE companies.
// The trainee's original company is always preserved via Trainee.companyId.
// ─────────────────────────────────────────────────────────────────────────────

model SessionEnrollment {
  id        String          @id @default(uuid())
  sessionId String
  session   TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  traineeId String
  trainee   Trainee         @relation(fields: [traineeId], references: [id], onDelete: Cascade)
  // The trainee's company at time of enrollment (snapshot — preserves original company)
  companyId String // trainee's original company (NOT the session's company)
  company   Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)

  // ── Enrollment lifecycle ──
  enrollmentStatus String    @default("PENDING")
  // PENDING | CONFIRMED | CHECKED_IN | TRAINING | COMPLETED | CANCELLED | NO_SHOW
  enrolledBy       String?
  enrollmentDate   DateTime  @default(now())
  completedDate    DateTime?
  notes            String?

  // ── Attendance status ──
  attendanceStatus String @default("NOT_STARTED")
  // NOT_STARTED | PRESENT | LATE | ABSENT

  // ── Pre-Test status ──
  preTestStatus String @default("PENDING")
  // NOT_REQUIRED | PENDING | IN_PROGRESS | COMPLETED

  // ── Final Test status ──
  finalTestStatus String @default("PENDING")
  // NOT_REQUIRED | PENDING | IN_PROGRESS | PASSED | FAILED

  // ── Evaluation status ──
  evaluationStatus String @default("PENDING")
  // NOT_REQUIRED | PENDING | COMPLETED

  // ── Certificate status ──
  certificateStatus String @default("NOT_ELIGIBLE")
  // NOT_ELIGIBLE | ELIGIBLE | GENERATED | ISSUED

  // ── Links to related records (for quick lookup) ──
  attendanceId String? // FK to Attendance record (set at check-in)

  // ── Re-Exam support ──
  isReExam     Boolean @default(false)

  // ── Enrollment source tracking ──
  // Records HOW this enrollment was created, for reporting and audit:
  //   COORDINATOR         — added manually by a coordinator
  //   TRAINER             — emergency add by a trainer during training
  //   CONTRACTOR_REQUEST  — originated from a contractor's training request
  //   MANUAL              — generic manual entry
  //   RE_EXAM             — re-exam enrollment (auto-detected)
  enrollmentSource String @default("MANUAL")
  // When true, this enrollment was added by a trainer and is pending
  // coordinator review. The coordinator can approve, edit, or reject.
  addedByTrainer  Boolean @default(false)
  pendingReview   Boolean @default(false)

  // Audit
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdBy String?
  updatedBy String?
  deletedAt DateTime?

  @@unique([sessionId, traineeId])
  @@index([sessionId])
  @@index([traineeId])
  @@index([companyId])
  @@index([enrollmentStatus])
  @@index([attendanceStatus])
  @@index([preTestStatus])
  @@index([finalTestStatus])
  @@index([evaluationStatus])
  @@index([certificateStatus])
  @@index([isReExam])
}

// Tracks which companies have trainees enrolled in a session (for multi-company reporting)
model SessionCompany {
  id           String          @id @default(uuid())
  sessionId    String
  session      TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  companyId    String
  company      Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  traineeCount Int             @default(0)
  addedAt      DateTime        @default(now())
  // Audit
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  createdBy    String?

  @@unique([sessionId, companyId])
  @@index([sessionId])
  @@index([companyId])
}

// ─────────────────────────────────────────────────────────────────────────────
// TRAINING SESSIONS + QR ATTENDANCE
// ─────────────────────────────────────────────────────────────────────────────

model TrainingSession {
  id                String                 @id @default(uuid())
  refNumber         String                 @unique // SES-000001
  courseId          String
  course            Course                 @relation(fields: [courseId], references: [id])
  requestId         String?
  request           TrainingRequest?       @relation(fields: [requestId], references: [id])
  requestCourseId   String? // link to specific course-in-request (multi-course support)
  requestCourse     TrainingRequestCourse? @relation(fields: [requestCourseId], references: [id], onDelete: SetNull)
  trainerId         String?
  trainer           Trainer?               @relation(fields: [trainerId], references: [id])
  title             String
  location          String?
  city              String?
  region            String?
  venue             String?
  shift             String? // MORNING | EVENING
  durationHours     Int                    @default(6)
  capacity          Int                    @default(20)
  language          String                 @default("en")
  startDate         DateTime
  endDate           DateTime
  expectedTrainees  Int                    @default(0)
  actualTrainees    Int                    @default(0)
  status            SessionStatus          @default(SCHEDULED)
  qrCodeToken       String?                @unique
  qrCodeGeneratedAt DateTime?
  // QR attendance window — QR is only active during this period
  qrActiveFrom      DateTime?
  qrActiveTo        DateTime?
  // Session lifecycle tracking
  lifecycleStatus   String                 @default("NOT_STARTED") // NOT_STARTED | STARTED | ON_BREAK | COMPLETED
  startedAt         DateTime?
  completedAt       DateTime?
  notes             String?
  // Import/export fields (course schedule sheet)
  instituteName     String? // اسم المعهد المنفذ
  classification    String                 @default("COURSE") // COURSE | EXAM — دورة / اختبار
  locationMapUrl    String? // احداثيات الموقع (map link)
  durationDays      Int? // مدة الدورة (days, as shown on the sheet)
  // Audit
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  createdBy         String?
  updatedBy         String?
  deletedAt         DateTime?

  attendance       Attendance[]
  checkInAttempts  CheckInAttempt[]
  testResults      TestResult[]
  examAttempts     ExamAttempt[]
  evaluations      CourseEvaluation[]
  certificates     Certificate[]
  lifecycleEvents  SessionLifecycleEvent[]
  enrollments      SessionEnrollment[]
  sessionCompanies SessionCompany[]
  // Financial module
  invoices         Invoice[]

  @@index([status])
  @@index([trainerId])
  @@index([startDate])
  @@index([shift])
  @@index([city])
  @@index([requestCourseId])
  @@index([lifecycleStatus])
}

// Session lifecycle events: STARTED → BREAK → RESUMED → COMPLETED
model SessionLifecycleEvent {
  id        String          @id @default(uuid())
  sessionId String
  session   TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  eventType String // STARTED | BREAK | RESUMED | COMPLETED
  eventTime DateTime        @default(now())
  notes     String?
  // Audit
  createdAt DateTime        @default(now())
  createdBy String?

  @@index([sessionId])
  @@index([eventType])
}

model Attendance {
  id                    String          @id @default(uuid())
  sessionId             String
  session               TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  traineeName           String
  traineeIdNational     String?
  traineeEmail          String?
  traineePhone          String?
  company               String?
  companyId             String?
  checkInAt             DateTime?
  checkOutAt            DateTime?
  status                String          @default("REGISTERED") // REGISTERED | PRESENT | ABSENT | LATE | EXCUSED
  checkInMethod         String? // QR | MANUAL
  notes                 String?
  // Device tracking for QR check-in
  deviceInfo            String? // JSON: { userAgent, ipAddress, platform, deviceFingerprint }
  // Training execution progress (pipeline tracking)
  preTestAssignedAt     DateTime?
  preTestCompletedAt    DateTime?
  finalTestAssignedAt   DateTime?
  finalTestCompletedAt  DateTime?
  finalTestPassed       Boolean?
  evaluationCompletedAt DateTime?
  certificateEligible   Boolean         @default(false)
  certificateId         String?
  // Audit
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  createdBy             String?
  updatedBy             String?
  deletedAt             DateTime?

  examAttempts ExamAttempt[]

  @@index([sessionId])
  @@index([status])
  @@index([traineeIdNational])
  @@index([certificateEligible])
}

// Tracks every QR scan attempt (success + failures) — for analytics + fraud detection
model CheckInAttempt {
  id                String          @id @default(uuid())
  sessionId         String
  session           TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  qrToken           String?
  traineeName       String?
  traineeEmail      String?
  traineeIdNational String?
  ipAddress         String?
  userAgent         String?
  success           Boolean
  failureReason     String?
  attendedAt        DateTime        @default(now())

  @@index([sessionId])
  @@index([success])
}

// ─────────────────────────────────────────────────────────────────────────────
// EXAMS (Test Results) — EXAM-YYYY-000001
// ─────────────────────────────────────────────────────────────────────────────

model TestResult {
  id                String          @id @default(uuid())
  refNumber         String          @unique // EXAM-YYYY-000001
  sessionId         String
  session           TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  testType          TestType
  traineeName       String
  traineeEmail      String?
  traineeIdNational String?
  companyId         String? // trainee's original company — preserved for per-company reporting
  company           Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  scorePercent      Int
  passed            Boolean
  answers           String? // JSON of { questionId, selected }
  attemptedAt       DateTime        @default(now())
  durationSec       Int?
  // AI-assisted exam metadata
  questionSet       String? // JSON snapshot of question IDs presented (for AI exams)
  // Audit
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  createdBy         String?
  updatedBy         String?
  deletedAt         DateTime?

  @@index([sessionId, testType])
  @@index([traineeEmail])
  @@index([companyId])
}

// ─────────────────────────────────────────────────────────────────────────────
// EXAM ATTEMPTS — randomized per-trainee exam versions
// Each attempt has a unique question set (randomized order + randomized answer choices)
// ─────────────────────────────────────────────────────────────────────────────

model ExamAttempt {
  id                String          @id @default(uuid())
  refNumber         String          @unique // EXAM-YYYY-000001
  sessionId         String
  session           TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  attendanceId      String?
  attendance        Attendance?     @relation(fields: [attendanceId], references: [id], onDelete: SetNull)
  testType          TestType // PRE_TEST | FINAL_TEST
  traineeName       String
  traineeEmail      String?
  traineeIdNational String?
  companyId         String? // trainee's original company — preserved for per-company reporting
  company           Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  // Randomized exam version — snapshot of question IDs + their option ordering
  questionSet       String // JSON: [{ questionId, order, optionsOrder: [0,2,1,3] }]
  // Attempt state
  status            String          @default("ASSIGNED") // ASSIGNED | IN_PROGRESS | SUBMITTED | GRADED
  attemptNumber     Int             @default(1)
  maxAttempts       Int             @default(1)
  // Grading
  scorePercent      Int?
  passed            Boolean?
  passScore         Int? // snapshot of course.passScore at time of attempt
  // Timing
  assignedAt        DateTime        @default(now())
  startedAt         DateTime?
  submittedAt       DateTime?
  durationSec       Int?
  // Answers — JSON: [{ questionId, selectedAnswerIndices: [...], correct: boolean }]
  answers           String?
  // Audit
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  createdBy         String?
  updatedBy         String?
  deletedAt         DateTime?

  @@index([sessionId, testType])
  @@index([attendanceId])
  @@index([status])
  @@index([traineeEmail])
  @@index([companyId])
}

// ─────────────────────────────────────────────────────────────────────────────
// COURSE EVALUATION
// ─────────────────────────────────────────────────────────────────────────────

model CourseEvaluation {
  id                String          @id @default(uuid())
  sessionId         String
  session           TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  trainerId         String?
  trainer           Trainer?        @relation(fields: [trainerId], references: [id])
  traineeName       String
  traineeEmail      String?
  traineeIdNational String?
  companyId         String? // trainee's original company — preserved for per-company reporting
  company           Company?        @relation(fields: [companyId], references: [id], onDelete: SetNull)
  attendanceId      String?
  trainerRating     Int
  contentRating     Int
  venueRating       Int
  materialsRating   Int
  overallRating     Int
  comments          String?
  suggestions       String? // Trainee's suggestions for improvement
  wouldRecommend    Boolean?
  submittedAt       DateTime        @default(now())
  // Audit
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  createdBy         String?
  updatedBy         String?
  deletedAt         DateTime?

  @@index([sessionId])
  @@index([trainerId])
  @@index([attendanceId])
  @@index([companyId])
}

// ─────────────────────────────────────────────────────────────────────────────
// CERTIFICATES + QR VERIFICATION
// ─────────────────────────────────────────────────────────────────────────────

model Certificate {
  id                String          @id @default(uuid())
  refNumber         String          @unique // CERT-YYYY-000001
  sessionId         String
  session           TrainingSession @relation(fields: [sessionId], references: [id])
  courseId          String
  course            Course          @relation(fields: [courseId], references: [id])
  companyId         String?
  company           Company?        @relation(fields: [companyId], references: [id])
  attendanceId      String? // link to attendance record that earned this certificate
  traineeName       String
  traineeIdNational String?
  traineeEmail      String?
  finalScore        Int
  issuedAt          DateTime        @default(now())
  validUntil        DateTime
  status            String          @default("VALID") // VALID | EXPIRED | REVOKED | RENEWED
  // Sprint 6: renewal chain
  renewedFromId     String?
  renewedFrom       Certificate?    @relation("CertRenewalChain", fields: [renewedFromId], references: [id], onDelete: SetNull)
  renewedBy         Certificate[]   @relation("CertRenewalChain")
  version           Int             @default(1) // 1 = original, 2+ = renewals
  renewedAt         DateTime?
  pdfUrl            String?
  pdfGeneratedAt    DateTime?
  // QR verification
  verificationToken String?         @unique
  qrCodeUrl         String?
  verificationCount Int             @default(0)
  lastVerifiedAt    DateTime?
  // Audit
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  createdBy         String?
  updatedBy         String?
  deletedAt         DateTime?

  verifications    CertificateVerification[]
  workerPassport   WorkerPassport?           @relation("WorkerPassportCertificates", fields: [workerPassportId], references: [id], onDelete: SetNull)
  workerPassportId String?

  @@index([sessionId])
  @@index([companyId])
  @@index([status])
  @@index([verificationToken])
  @@index([attendanceId])
  @@index([renewedFromId])
  @@index([validUntil])
}
model CertificateVerification {
  id                String      @id @default(uuid())
  certificateId     String
  certificate       Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)
  verificationToken String?
  ipAddress         String?
  userAgent         String?
  countryCode       String?
  verifiedAt        DateTime    @default(now())

  @@index([certificateId])
  @@index([verifiedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// WORKER TRAINING PASSPORT & COMPLIANCE MATRIX (Sprint 6)
// ─────────────────────────────────────────────────────────────────────────────

// One permanent digital passport per worker, keyed by National ID / Iqama.
// Auto-generated when a certificate is first issued to a trainee whose
// nationalId isn't yet linked to a passport. The worker does NOT create or
// edit the passport — it is purely system-managed.
model WorkerPassport {
  id             String    @id @default(uuid())
  passportNumber String    @unique // WP-YYYY-NNNNNN
  nationalId     String    @unique // National ID or Iqama (unique key)
  fullName       String
  companyId      String?
  company        Company?  @relation(fields: [companyId], references: [id], onDelete: SetNull)
  jobTitle       String?
  mobile         String?
  email          String?
  // QR code — separate from certificate QR. Points to /worker/{qrToken}
  qrToken        String    @unique @default(uuid())
  qrCodeUrl      String?
  // Audit
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?

  // Relations
  certificates Certificate[] @relation("WorkerPassportCertificates")

  @@index([nationalId])
  @@index([companyId])
  @@index([qrToken])
  @@index([passportNumber])
}

// Compliance Rule — admin-configurable mandatory course requirements.
// Each rule maps a Course to a scope (All Workers / Company / Job Title / Project / Client).
model ComplianceRule {
  id              String    @id @default(uuid())
  courseId        String
  course          Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  isMandatory     Boolean   @default(true) // mandatory vs. recommended
  isCoreMandatory Boolean   @default(false) // OHS/Fire Safety/First Aid — only SUPER_ADMIN can disable
  validityMonths  Int       @default(24) // override course.validityMonths if set
  // Scope: who does this rule apply to?
  scopeType       String    @default("ALL") // ALL | COMPANY | JOB_TITLE | PROJECT | CLIENT
  scopeValue      String? // company ID, job title string, project name, or client name
  scopeLabel      String? // human-readable: "Acme Co." or "Electrician" or "Project X"
  isActive        Boolean   @default(true)
  // Audit
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?

  versions ComplianceRuleVersion[]

  @@index([courseId])
  @@index([scopeType])
  @@index([isActive])
  @@index([scopeType, scopeValue])
}

// Immutable audit trail for every compliance rule change.
// Never deleted — full history of who changed what, when, and why.
model ComplianceRuleVersion {
  id              String         @id @default(uuid())
  ruleId          String
  rule            ComplianceRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  version         Int            @default(1)
  // Snapshot of the rule at this version
  courseId        String
  isMandatory     Boolean
  isCoreMandatory Boolean
  validityMonths  Int
  scopeType       String
  scopeValue      String?
  scopeLabel      String?
  isActive        Boolean
  // Change metadata
  changedBy       String
  changedAt       DateTime       @default(now())
  changeType      String // CREATE | UPDATE | ACTIVATE | DEACTIVATE
  reason          String? // optional reason for the change
  // Before/after diff (JSON)
  previousValues  String? // JSON string of previous field values

  @@index([ruleId])
  @@index([changedAt])
  @@index([changeType])
}

// ─────────────────────────────────────────────────────────────────────────────
// NOTIFICATIONS (multi-channel: in-app, email, push, SMS — future mobile)
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id          String    @id @default(uuid())
  userId      String?
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)
  title       String
  titleAr     String?
  message     String
  messageAr   String?
  type        String    @default("INFO") // INFO | SUCCESS | WARNING | ERROR | REQUEST
  category    String    @default("SYSTEM") // SYSTEM | REQUEST | SESSION | CERTIFICATE | TEST
  link        String?
  isRead      Boolean   @default(false)
  readAt      DateTime?
  // Multi-channel support
  channels    String? // JSON: ["in_app", "email", "push", "sms"]
  emailSentAt DateTime?
  pushSentAt  DateTime?
  // Audit
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId, isRead])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// AUDIT LOG — captures every required action automatically
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id            String   @id @default(uuid())
  userId        String?
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action        String // LOGIN | LOGOUT | FAILED_LOGIN | CREATE | UPDATE | DELETE | APPROVE | REJECT | ISSUE_CERT | RENEW_CERT | GENERATE_QR | VERIFY_QR | CREATE_WORKER | UPDATE_WORKER | DELETE_WORKER | CREATE_COMPANY | UPDATE_COMPANY | COMPLIANCE_CHANGE | PERMISSION_CHANGE | STATUS_CHANGE | EXAM_SUBMIT | CERTIFICATE_GENERATE | ISSUE | REVOKE | QR_REGENERATE | EXPORT
  entity        String // COMPANY | TRAINER | TRAINEE | COURSE | REQUEST | SESSION | CERTIFICATE | USER | ROLE | SETTING | EXAM | ATTENDANCE | EVALUATION | WORKER_PASSPORT | COMPLIANCE_RULE | QR_CODE
  entityId      String?
  entityRef     String? // human-readable ref number (TR-..., CERT-..., etc.)
  description   String
  descriptionAr String?
  ipAddress     String?
  userAgent     String?
  // Sprint 6: Enterprise Audit Trail — extended fields
  userRole      String? // role of the user at time of action
  browser       String? // parsed from UA
  device        String? // parsed from UA
  oldValue      String? // JSON: previous field values (for UPDATE/DELETE)
  newValue      String? // JSON: new field values (for CREATE/UPDATE)
  reason        String? // optional reason for the action
  metadata      String? // JSON: before/after diff for UPDATE, old/new status for STATUS_CHANGE
  createdAt     DateTime @default(now())

  @@index([userId])
  @@index([entity])
  @@index([action])
  @@index([createdAt])
  @@index([ipAddress])
}

// ─────────────────────────────────────────────────────────────────────────────
// SCHEDULED REPORTS — automated report generation + email delivery
// =====================================================================
// ReportSchedule defines what report to generate, when, for whom, and
// where to email it. ReportExecution logs every run with delivery status.
// ─────────────────────────────────────────────────────────────────────────────

model ReportSchedule {
  id              String    @id @default(uuid())
  name            String
  nameAr          String?
  description     String?
  // Template
  templateCode    String // e.g. "GCCLAB_MONTHLY"
  // Schedule type
  scheduleType    String // WEEKLY | MONTHLY | DAILY | CUSTOM
  // Cron expression for flexible scheduling (e.g. "0 9 * * 4" = every Thursday 9am)
  cronExpression  String // standard 5-field cron
  // Configurable execution time
  executionTime   String? // "HH:mm" (24h, e.g. "09:00") — used for display + default
  timezone        String    @default("Asia/Riyadh")
  // Day of week (0=Sun, 4=Thu) — for WEEKLY type
  dayOfWeek       Int? // 0-6
  // Day of month (1-31) — for MONTHLY type
  dayOfMonth      Int? // 1-31
  // Filters — JSON object passed to the template query
  filters         String? // JSON: { month, companyId, region, city, ... }
  // Export format
  exportFormats   String    @default("xlsx") // JSON: ["xlsx", "pdf"]
  // Email recipients — JSON array of email addresses
  recipients      String // JSON: ["email1@example.com", "email2@example.com"]
  ccRecipients    String? // JSON: ["cc1@example.com"]
  bccRecipients   String? // JSON: ["bcc1@example.com"]
  emailSubject    String?
  emailBody       String?
  // Status
  isActive        Boolean   @default(true)
  // Tracking
  lastRunAt       DateTime?
  nextRunAt       DateTime?
  lastExecutionId String?
  // Retry config
  maxRetries      Int       @default(3)
  retryDelayMin   Int       @default(10) // minutes between retries
  // Audit
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?

  executions ReportExecution[]

  @@index([isActive])
  @@index([nextRunAt])
  @@index([scheduleType])
}

model ReportExecution {
  id              String         @id @default(uuid())
  scheduleId      String
  schedule        ReportSchedule @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  // Execution details
  status          String         @default("PENDING")
  // PENDING | RUNNING | GENERATING | SENDING | SENT | COMPLETED | FAILED | RETRYING
  // | SUPERSEDED | CANCELLED
  // COMPLETED  = report generated and stored, but nothing was emailed (SMTP not configured)
  // SUPERSEDED = a retry produced a newer execution that replaces this one
  triggerType     String         @default("SCHEDULED") // SCHEDULED | MANUAL
  triggeredBy     String? // user id (for MANUAL)
  // Report data
  templateCode    String
  rowCount        Int?
  filterSummary   String? // JSON: actual filter used
  // Export files — JSON: [{ format, filename, sizeBytes }]
  exportedFiles   String?
  // Email delivery
  emailStatus     String? // PENDING | SENT | FAILED | SKIPPED | SIMULATED
  // SIMULATED = SMTP is not configured; the send was logged, not performed.
  // This exists because the email service used to report success in that case and
  // the row was written as SENT, so the UI claimed reports had been delivered.
  emailSentAt     DateTime?
  emailError      String?
  emailRecipients String? // actual recipients used
  // Retry tracking
  attemptNumber   Int            @default(1)
  maxRetries      Int            @default(3)
  nextRetryAt     DateTime?
  // Timing
  startedAt       DateTime       @default(now())
  completedAt     DateTime?
  durationMs      Int?
  // Error
  errorMessage    String?
  errorStack      String?
  // Audit
  createdAt       DateTime       @default(now())

  files ReportExecutionFile[]

  @@index([scheduleId])
  @@index([status])
  @@index([createdAt])
  @@index([emailStatus])
}

// Generated report files, stored as blobs.
//
// The execution engine used to build the xlsx/pdf buffers, record their sizes in
// ReportExecution.exportedFiles, and then let them be garbage collected — there was no
// storage column and no download route, so a "successful" scheduled report produced
// nothing a human could ever obtain.
//
// A separate table rather than columns on ReportExecution: Prisma has no column-level
// lazy loading, so a `content Bytes` on the execution row would be pulled into memory by
// the executions list query unless every single caller remembered to `select` around it.
model ReportExecutionFile {
  id          String          @id @default(uuid())
  executionId String
  execution   ReportExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)
  format      String // xlsx | pdf
  filename    String
  mimeType    String
  sizeBytes   Int
  content     Bytes // BLOB on SQLite
  checksum    String? // sha256 hex
  expiresAt   DateTime?
  createdAt   DateTime        @default(now())

  @@index([executionId])
  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// FINANCIAL MODULE — Invoices, Quotations, Payments, Receipts, Bank Accounts
// ─────────────────────────────────────────────────────────────────────────────

// Company-level financial settings (single row, stored as key-value).
// This is the "our company" info that appears on invoices. Stored separately
// from the SystemSettings table because financial data has different access
// patterns and audit requirements.
model FinancialSettings {
  id              String   @id @default("default")
  // Company information (snapshot source for invoices)
  companyName     String   @default("GCC ELECTRICAL TESTING LABORATORY")
  crNumber        String?  // Commercial Registration
  vatNumber       String?  // VAT Registration Number
  financeEmail    String?
  companyLogoUrl  String?
  address         String?
  phone           String?
  currency        String   @default("SAR")
  // Sequences
  invoiceSeq      Int      @default(1)
  quotationSeq    Int      @default(1)
  receiptSeq      Int      @default(1)
  // VAT rate (percentage, e.g. 15 for 15%)
  vatRate         Float @default(15)
  // Default due date offset (days from issue date)
  defaultDueDays  Int      @default(30)
  // Audit
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  updatedBy       String?
}

// Multiple bank accounts. The coordinator selects which one appears on each
// invoice. Supports future QR-IBAN display.
model BankAccount {
  id              String   @id @default(uuid())
  bankName        String
  beneficiary     String
  accountNumber   String
  iban            String?
  swift           String?
  qrImageUrl      String?  // future: QR-IBAN image
  isActive        Boolean  @default(true)
  isDefault       Boolean  @default(false)
  // Audit
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?

  invoices        Invoice[]

  @@index([isActive])
}

// Quotation — a price quote sent to a contractor before an invoice.
// A request can have multiple quotations (revisions, different course mixes).
model Quotation {
  id              String   @id @default(uuid())
  refNumber       String   @unique // QUO-YYYY-000001
  requestId       String?
  request         TrainingRequest? @relation(fields: [requestId], references: [id])
  companyId       String   // contractor
  company         Company  @relation(fields: [companyId], references: [id])
  // Line items stored as JSON (course title, trainee count, unit price, etc.)
  lineItems       String   // JSON array
  // Totals
  subtotal        Float
  discountAmount  Float @default(0)
  discountPercent Float?
  vatAmount       Float
  grandTotal      Float
  currency        String   @default("SAR")
  vatRate         Float
  // Status
  status          String   @default("DRAFT") // DRAFT | SENT | ACCEPTED | REJECTED | EXPIRED | CONVERTED
  // Validity
  issueDate       DateTime @default(now())
  validUntil      DateTime?
  // Notes
  notes           String?
  termsConditions String?
  // Snapshot of company info at quotation issue time
  snapshot        String?  // JSON: { companyName, crNumber, vatNumber, address, logoUrl, ... }
  // Audit
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?

  invoices        Invoice[]

  @@index([companyId])
  @@index([requestId])
  @@index([status])
}

// Invoice — the formal billing document. Stores a full snapshot of all
// company/bank/VAT info at issue time so it NEVER changes retroactively.
model Invoice {
  id              String   @id @default(uuid())
  refNumber       String   @unique // INV-YYYY-000001
  quotationId     String?
  quotation       Quotation? @relation(fields: [quotationId], references: [id])
  requestId       String?
  request         TrainingRequest? @relation(fields: [requestId], references: [id])
  sessionId       String?
  session         TrainingSession? @relation(fields: [sessionId], references: [id])
  companyId       String   // contractor
  company         Company  @relation(fields: [companyId], references: [id])
  // Line items (JSON: [{ courseTitle, traineeCount, unitPrice, lineTotal }])
  lineItems       String   // JSON array
  // Totals
  subtotal        Float
  discountAmount  Float @default(0)
  discountPercent Float?
  vatAmount       Float
  grandTotal      Float
  paidAmount      Float @default(0)
  outstandingBalance Float
  currency        String   @default("SAR")
  vatRate         Float
  // Status
  status          String   @default("DRAFT") // DRAFT | ISSUED | PENDING_PAYMENT | PARTIALLY_PAID | PAID | CANCELLED | REFUNDED | OVERDUE
  // Dates
  issueDate       DateTime @default(now())
  dueDate         DateTime?
  paidDate        DateTime?
  // Bank account selected for this invoice
  bankAccountId   String?
  bankAccount     BankAccount? @relation(fields: [bankAccountId], references: [id])
  // Notes
  coordinatorNotes String?
  paymentNotes    String?
  // Snapshot — CRITICAL: frozen copy of all company/bank/VAT info at issue
  // time. If settings change later, old invoices are unaffected.
  snapshot        String   // JSON: { company: {...}, bank: {...}, vatRate, currency, ... }
  // PDF
  pdfUrl          String?
  pdfGeneratedAt  DateTime?
  // Audit
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?

  payments        Payment[]
  receipts        Receipt[]
  paymentInvoices PaymentInvoice[]

  @@index([companyId])
  @@index([requestId])
  @@index([sessionId])
  @@index([status])
  @@index([issueDate])
  @@index([dueDate])
}

// Payment — records money received. One payment can cover multiple invoices
// (split payment). One invoice can receive multiple partial payments.
model Payment {
  id              String   @id @default(uuid())
  refNumber       String   @unique // PAY-YYYY-000001
  // Link to invoice(s) — if one payment covers multiple invoices, use
  // PaymentInvoice junction. For the common case (one payment = one invoice),
  // invoiceId is set directly.
  invoiceId       String?
  invoice         Invoice? @relation(fields: [invoiceId], references: [id])
  // Multi-invoice payments use the junction table
  paymentInvoices PaymentInvoice[]
  // Contractor
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  // Amount
  amount          Float
  vatAmount       Float @default(0)
  currency        String   @default("SAR")
  // Payment method (future-ready for gateway integrations)
  method          String   // BANK_TRANSFER | SADAD | MADA | VISA | MASTERCARD | APPLE_PAY | CASH | CHEQUE | MANUAL
  // Status
  status          String   @default("PENDING") // PENDING | PAID | FAILED | CANCELLED | REFUNDED | EXPIRED
  // Dates
  paymentDate     DateTime @default(now())
  // Reference (cheque number, transaction ID, SADAD number, etc.)
  referenceNumber String?
  // Bank account (for bank transfers)
  bankAccountId   String?
  // Payer info
  paidBy          String?  // name of the person who paid
  // Gateway fields (future-ready — populated when gateways are integrated)
  gatewayTransactionId String?
  gatewayName     String?  // hyperpay | mada | sadad | etc.
  gatewayResponse String?  // JSON: full gateway response
  gatewayCallbackUrl String?
  // Notes
  notes           String?
  // Audit
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?

  receipts        Receipt[]

  @@index([invoiceId])
  @@index([companyId])
  @@index([status])
  @@index([paymentDate])
  @@index([method])
}

// Junction: one payment → many invoices (for split payments)
model PaymentInvoice {
  id              String   @id @default(uuid())
  paymentId       String
  payment         Payment  @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  invoiceId       String
  invoice         Invoice  @relation(fields: [invoiceId], references: [id])
  // Amount allocated to this invoice from the payment
  allocatedAmount Float

  @@unique([paymentId, invoiceId])
  @@index([paymentId])
  @@index([invoiceId])
}

// Receipt — auto-generated when a payment is confirmed.
model Receipt {
  id              String   @id @default(uuid())
  refNumber       String   @unique // RCP-YYYY-000001
  paymentId       String?
  payment         Payment? @relation(fields: [paymentId], references: [id])
  invoiceId       String?
  invoice         Invoice? @relation(fields: [invoiceId], references: [id])
  companyId       String
  company         Company  @relation(fields: [companyId], references: [id])
  // Amount
  amount          Float
  vatAmount       Float @default(0)
  currency        String   @default("SAR")
  // Details
  receiptDate     DateTime @default(now())
  paymentMethod   String?
  paidBy          String?
  bankName        String?
  referenceNumber String?
  // Status
  status          String   @default("ISSUED") // ISSUED | CANCELLED
  // PDF
  pdfUrl          String?
  pdfGeneratedAt  DateTime?
  // Snapshot
  snapshot        String?  // JSON: company info at receipt time
  // Audit
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?

  @@index([paymentId])
  @@index([invoiceId])
  @@index([companyId])
  @@index([receiptDate])
}
