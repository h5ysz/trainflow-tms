generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Attendance {
  id                    String          @id
  sessionId             String
  traineeName           String
  traineeIdNational     String?
  traineeEmail          String?
  traineePhone          String?
  company               String?
  companyId             String?
  checkInAt             DateTime?
  checkOutAt            DateTime?
  status                String          @default("REGISTERED")
  checkInMethod         String?
  notes                 String?
  deviceInfo            String?
  preTestAssignedAt     DateTime?
  preTestCompletedAt    DateTime?
  finalTestAssignedAt   DateTime?
  finalTestCompletedAt  DateTime?
  finalTestPassed       Boolean?
  evaluationCompletedAt DateTime?
  certificateEligible   Boolean         @default(false)
  certificateId         String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime
  createdBy             String?
  updatedBy             String?
  deletedAt             DateTime?
  trainingSession       TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  examAttempt           ExamAttempt[]

  @@index([certificateEligible])
  @@index([traineeIdNational])
  @@index([status])
  @@index([sessionId])
}

model AuditLog {
  id            String   @id
  userId        String?
  action        String
  entity        String
  entityId      String?
  entityRef     String?
  description   String
  descriptionAr String?
  ipAddress     String?
  userAgent     String?
  userRole      String?
  browser       String?
  device        String?
  oldValue      String?
  newValue      String?
  reason        String?
  metadata      String?
  createdAt     DateTime @default(now())
  user          User?    @relation(fields: [userId], references: [id])

  @@index([ipAddress])
  @@index([createdAt])
  @@index([action])
  @@index([entity])
  @@index([userId])
}

model BankAccount {
  id            String    @id
  bankName      String
  beneficiary   String
  accountNumber String
  iban          String?
  swift         String?
  qrImageUrl    String?
  isActive      Boolean   @default(true)
  isDefault     Boolean   @default(false)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime
  createdBy     String?
  updatedBy     String?
  deletedAt     DateTime?
  invoices       Invoice[]

  @@index([isActive])
}

model Certificate {
  id                                  String                    @id
  refNumber                           String                    @unique
  sessionId                           String
  courseId                            String
  companyId                           String?
  attendanceId                        String?
  traineeName                         String
  traineeIdNational                   String?
  traineeEmail                        String?
  finalScore                          Int
  issuedAt                            DateTime                  @default(now())
  validUntil                          DateTime
  status                              String                    @default("VALID")
  releaseStatus                       String                    @default("DRAFT")
  releasedAt                          DateTime?
  releasedBy                          String?
  downloadedAt                        DateTime?
  professionVerified                  Boolean                   @default(false)
  professionVerifiedAt                DateTime?
  professionVerifiedBy                String?
  professionVerificationNotes         String?
  professionVerificationAttachmentUrl String?
  renewedFromId                       String?
  version                             Int                       @default(1)
  renewedAt                           DateTime?
  pdfUrl                              String?
  pdfGeneratedAt                      DateTime?
  verificationToken                   String?                   @unique
  qrCodeUrl                           String?
  verificationCount                   Int                       @default(0)
  lastVerifiedAt                      DateTime?
  createdAt                           DateTime                  @default(now())
  updatedAt                           DateTime
  createdBy                           String?
  updatedBy                           String?
  deletedAt                           DateTime?
  workerPassportId                    String?
  workerPassport                      WorkerPassport?           @relation(fields: [workerPassportId], references: [id])
  renewedFrom                         Certificate?              @relation("CertificateToCertificate", fields: [renewedFromId], references: [id])
  other_Certificate                   Certificate[]             @relation("CertificateToCertificate")
  company                             Company?                  @relation(fields: [companyId], references: [id])
  course                              Course                    @relation(fields: [courseId], references: [id])
  trainingSession                     TrainingSession           @relation(fields: [sessionId], references: [id])
  verifications             CertificateVerification[]

  @@index([validUntil])
  @@index([renewedFromId])
  @@index([attendanceId])
  @@index([verificationToken])
  @@index([releaseStatus])
  @@index([status])
  @@index([companyId])
  @@index([sessionId])
}

model CertificateVerification {
  id                String      @id
  certificateId     String
  verificationToken String?
  ipAddress         String?
  userAgent         String?
  countryCode       String?
  verifiedAt        DateTime    @default(now())
  certificate       Certificate @relation(fields: [certificateId], references: [id], onDelete: Cascade)

  @@index([verifiedAt])
  @@index([certificateId])
}

model CheckInAttempt {
  id                String          @id
  sessionId         String
  qrToken           String?
  traineeName       String?
  traineeEmail      String?
  traineeIdNational String?
  ipAddress         String?
  userAgent         String?
  success           Boolean
  failureReason     String?
  attendedAt        DateTime        @default(now())
  trainingSession   TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([success])
  @@index([sessionId])
}

model Company {
  id                String              @id
  refNumber         String              @unique
  name              String
  nameAr            String?
  legalName         String?
  crNumber          String?
  vatNumber         String?
  industry          String?
  country           String?
  city              String?
  address           String?
  postalCode        String?
  phone             String?
  email             String?
  website           String?
  contactPerson     String?
  contactPhone      String?
  contactEmail      String?
  status            String              @default("ACTIVE")
  logoUrl           String?
  tenantId          String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime
  createdBy         String?
  updatedBy         String?
  deletedAt         DateTime?
  certificates       Certificate[]
  tenant            Tenant?             @relation(fields: [tenantId], references: [id])
  contacts    CompanyContact[]
  evaluations  CourseEvaluation[]
  examAttempts       ExamAttempt[]
  invoices           Invoice[]
  payments           Payment[]
  quotations         Quotation[]
  receipts           Receipt[]
  sessionCompanies    SessionCompany[]
  enrollments SessionEnrollment[]
  sessionPayments    SessionPayment[]
  testResults        TestResult[]
  trainees           Trainee[]
  trainingRequests   TrainingRequest[]
  users              User[]
  workerPassports    WorkerPassport[]

  @@index([tenantId])
  @@index([status])
}

model CompanyContact {
  id               String    @id
  companyId        String
  fullName         String
  jobTitle         String?
  email            String?
  phone            String?
  mobile           String?
  preferredContact String?
  isPrimary        Boolean   @default(false)
  isActive         Boolean   @default(true)
  notes            String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime
  createdBy        String?
  updatedBy        String?
  deletedAt        DateTime?
  company          Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId])
}

model ComplianceRule {
  id                    String                  @id
  courseId              String
  isMandatory           Boolean                 @default(true)
  isCoreMandatory       Boolean                 @default(false)
  validityMonths        Int                     @default(24)
  scopeType             String                  @default("ALL")
  scopeValue            String?
  scopeLabel            String?
  isActive              Boolean                 @default(true)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  createdBy             String?
  updatedBy             String?
  deletedAt             DateTime?
  courses                Course                  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  versions ComplianceRuleVersion[]

  @@index([scopeType, scopeValue])
  @@index([isActive])
  @@index([scopeType])
  @@index([courseId])
}

model ComplianceRuleVersion {
  id              String         @id
  ruleId          String
  version         Int            @default(1)
  courseId        String
  isMandatory     Boolean
  isCoreMandatory Boolean
  validityMonths  Int
  scopeType       String
  scopeValue      String?
  scopeLabel      String?
  isActive        Boolean
  changedBy       String
  changedAt       DateTime       @default(now())
  changeType      String
  reason          String?
  previousValues  String?
  complianceRule  ComplianceRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@index([changeType])
  @@index([changedAt])
  @@index([ruleId])
}

model Course {
  id                             String                  @id
  refNumber                      String                  @unique
  code                           String                  @unique
  title                          String
  titleAr                        String?
  description                    String?
  category                       String?
  durationHours                  Int                     @default(8)
  language                       String                  @default("en")
  validityMonths                 Int                     @default(12)
  passScore                      Int                     @default(70)
  maxTrainees                    Int                     @default(20)
  hasPreTest                     Boolean                 @default(true)
  hasFinalTest                   Boolean                 @default(true)
  hasEvaluation                  Boolean                 @default(true)
  status                         String                  @default("ACTIVE")
  tenantId                       String?
  aiExamEnabled                  Boolean                 @default(false)
  aiExamConfig                   String?
  requiresProfessionVerification Boolean                 @default(false)
  retakeAttempts                 Int                     @default(1)
  createdAt                      DateTime                @default(now())
  updatedAt                      DateTime
  createdBy                      String?
  updatedBy                      String?
  deletedAt                      DateTime?
  certificates                    Certificate[]
  complianceRules                 ComplianceRule[]
  tenant                         Tenant?                 @relation(fields: [tenantId], references: [id])
  resources                 CourseResource[]
  questions                       Question[]
  trainerCertifications           TrainerCertification[]
  requests                TrainingRequest[]
  requestCourses          TrainingRequestCourse[]
  sessions                TrainingSession[]

  @@index([tenantId])
  @@index([category])
  @@index([status])
}

model CourseEvaluation {
  id                String          @id
  sessionId         String
  trainerId         String?
  traineeName       String
  traineeEmail      String?
  traineeIdNational String?
  companyId         String?
  attendanceId      String?
  trainerRating     Int
  contentRating     Int
  venueRating       Int
  materialsRating   Int
  overallRating     Int
  comments          String?
  suggestions       String?
  wouldRecommend    Boolean?
  submittedAt       DateTime        @default(now())
  createdAt         DateTime        @default(now())
  updatedAt         DateTime
  createdBy         String?
  updatedBy         String?
  deletedAt         DateTime?
  company           Company?        @relation(fields: [companyId], references: [id])
  trainer           Trainer?        @relation(fields: [trainerId], references: [id])
  trainingSession   TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([attendanceId])
  @@index([trainerId])
  @@index([sessionId])
}

model CourseResource {
  id          String    @id
  courseId    String
  type        String
  title       String
  titleAr     String?
  url         String
  description String?
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?
  course      Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([type])
  @@index([courseId])
}

model ExamAttempt {
  id                String          @id
  refNumber         String          @unique
  sessionId         String
  attendanceId      String?
  testType          String
  traineeName       String
  traineeEmail      String?
  traineeIdNational String?
  companyId         String?
  questionSet       String
  status            String          @default("ASSIGNED")
  attemptNumber     Int             @default(1)
  maxAttempts       Int             @default(1)
  scorePercent      Int?
  passed            Boolean?
  passScore         Int?
  assignedAt        DateTime        @default(now())
  startedAt         DateTime?
  submittedAt       DateTime?
  durationSec       Int?
  answers           String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime
  createdBy         String?
  updatedBy         String?
  deletedAt         DateTime?
  company           Company?        @relation(fields: [companyId], references: [id])
  attendance        Attendance?     @relation(fields: [attendanceId], references: [id])
  trainingSession   TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([traineeEmail])
  @@index([status])
  @@index([attendanceId])
  @@index([sessionId, testType])
}

model FinancialSettings {
  id             String   @id @default("default")
  companyName    String   @default("GCC ELECTRICAL TESTING LABORATORY")
  crNumber       String?
  vatNumber      String?
  financeEmail   String?
  companyLogoUrl String?
  address        String?
  phone          String?
  currency       String   @default("SAR")
  invoiceSeq     Int      @default(1)
  quotationSeq   Int      @default(1)
  receiptSeq     Int      @default(1)
  vatRate        Float    @default(15)
  defaultDueDays Int      @default(30)
  createdAt      DateTime @default(now())
  updatedAt      DateTime
  updatedBy      String?
}

model Invoice {
  id                 String           @id
  refNumber          String           @unique
  quotationId        String?
  requestId          String?
  sessionId          String?
  companyId          String
  lineItems          String
  subtotal           Float
  discountAmount     Float            @default(0)
  discountPercent    Float?
  vatAmount          Float
  grandTotal         Float
  paidAmount         Float            @default(0)
  outstandingBalance Float
  currency           String           @default("SAR")
  vatRate            Float
  status             String           @default("DRAFT")
  issueDate          DateTime         @default(now())
  dueDate            DateTime?
  paidDate           DateTime?
  bankAccountId      String?
  coordinatorNotes   String?
  paymentNotes       String?
  snapshot           String
  pdfUrl             String?
  pdfGeneratedAt     DateTime?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime
  createdBy          String?
  updatedBy          String?
  deletedAt          DateTime?
  bankAccount        BankAccount?     @relation(fields: [bankAccountId], references: [id])
  company            Company          @relation(fields: [companyId], references: [id])
  trainingSession    TrainingSession? @relation(fields: [sessionId], references: [id])
  trainingRequest    TrainingRequest? @relation(fields: [requestId], references: [id])
  quotation          Quotation?       @relation(fields: [quotationId], references: [id])
  payments            Payment[]
  paymentInvoice     PaymentInvoice[]
  receipts            Receipt[]

  @@index([dueDate])
  @@index([issueDate])
  @@index([status])
  @@index([sessionId])
  @@index([requestId])
  @@index([companyId])
}

model Language {
  id         String   @id
  code       String   @unique
  name       String
  nameNative String
  direction  String   @default("ltr")
  isDefault  Boolean  @default(false)
  isActive   Boolean  @default(true)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime
}

model LoginHistory {
  id            String   @id
  userId        String?
  email         String
  success       Boolean
  failureReason String?
  ipAddress     String?
  userAgent     String?
  attemptedAt   DateTime @default(now())
  user          User?    @relation(fields: [userId], references: [id])

  @@index([attemptedAt])
  @@index([email])
  @@index([userId])
}

model Notification {
  id          String    @id
  userId      String?
  title       String
  titleAr     String?
  message     String
  messageAr   String?
  type        String    @default("INFO")
  category    String    @default("SYSTEM")
  link        String?
  isRead      Boolean   @default(false)
  readAt      DateTime?
  channels    String?
  emailSentAt DateTime?
  pushSentAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  user        User?     @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([userId, isRead])
}

model Payment {
  id                   String           @id
  refNumber            String           @unique
  invoiceId            String?
  companyId            String
  amount               Float
  vatAmount            Float            @default(0)
  currency             String           @default("SAR")
  method               String
  status               String           @default("PENDING")
  paymentDate          DateTime         @default(now())
  referenceNumber      String?
  bankAccountId        String?
  paidBy               String?
  gatewayTransactionId String?
  gatewayName          String?
  gatewayResponse      String?
  gatewayCallbackUrl   String?
  notes                String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime
  createdBy            String?
  updatedBy            String?
  deletedAt            DateTime?
  company              Company          @relation(fields: [companyId], references: [id])
  invoice              Invoice?         @relation(fields: [invoiceId], references: [id])
  paymentInvoice       PaymentInvoice[]
  receipt              Receipt[]

  @@index([status])
  @@index([companyId])
  @@index([invoiceId])
}

model PaymentInvoice {
  id        String  @id
  paymentId String
  invoiceId String
  amount    Float
  invoice   Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
  @@index([paymentId])
}

model Permission {
  id          String   @id
  code        String   @unique
  module      String
  action      String
  description String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime

  @@index([action])
  @@index([module])
}

model Question {
  id             String    @id
  courseId       String?
  type           String    @default("SINGLE_CHOICE")
  testType       String    @default("PRE_TEST")
  text           String
  textAr         String?
  options        String
  correctAnswers String
  points         Int       @default(1)
  order          Int       @default(0)
  isActive       Boolean   @default(true)
  category       String?
  difficulty     String    @default("MEDIUM")
  tags           String?
  source         String    @default("MANUAL")
  aiGeneratedAt  DateTime?
  aiModel        String?
  aiPrompt       String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?
  course         Course?   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@index([difficulty])
  @@index([category])
  @@index([courseId, testType])
}

model Quotation {
  id              String           @id
  refNumber       String           @unique
  requestId       String?
  companyId       String
  lineItems       String
  subtotal        Float
  discountAmount  Float            @default(0)
  discountPercent Float?
  vatAmount       Float
  grandTotal      Float
  currency        String           @default("SAR")
  vatRate         Float
  status          String           @default("DRAFT")
  notes           String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?
  invoice         Invoice[]
  company         Company          @relation(fields: [companyId], references: [id])
  trainingRequest TrainingRequest? @relation(fields: [requestId], references: [id])

  @@index([status])
  @@index([requestId])
  @@index([companyId])
}

model Receipt {
  id              String    @id
  refNumber       String    @unique
  paymentId       String?
  invoiceId       String?
  companyId       String
  amount          Float
  vatAmount       Float     @default(0)
  currency        String    @default("SAR")
  receiptDate     DateTime  @default(now())
  paymentMethod   String?
  paidBy          String?
  bankName        String?
  referenceNumber String?
  status          String    @default("ISSUED")
  pdfUrl          String?
  pdfGeneratedAt  DateTime?
  snapshot        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?
  company         Company   @relation(fields: [companyId], references: [id])
  invoice         Invoice?  @relation(fields: [invoiceId], references: [id])
  payment         Payment?  @relation(fields: [paymentId], references: [id])

  @@index([receiptDate])
  @@index([companyId])
  @@index([invoiceId])
  @@index([paymentId])
}

model RefNumberCounter {
  id         String   @id
  entityType String
  year       Int?
  sequence   Int      @default(0)
  createdAt  DateTime @default(now())
  updatedAt  DateTime

  @@unique([entityType, year])
}

model ReportExecution {
  id                  String                @id
  scheduleId          String
  status              String                @default("PENDING")
  triggerType         String                @default("SCHEDULED")
  triggeredBy         String?
  templateCode        String
  rowCount            Int?
  filterSummary       String?
  exportedFiles       String?
  emailStatus         String?
  emailSentAt         DateTime?
  emailError          String?
  emailRecipients     String?
  attemptNumber       Int                   @default(1)
  maxRetries          Int                   @default(3)
  nextRetryAt         DateTime?
  startedAt           DateTime              @default(now())
  completedAt         DateTime?
  durationMs          Int?
  errorMessage        String?
  errorStack          String?
  createdAt           DateTime              @default(now())
  reportSchedule      ReportSchedule        @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  reportExecutionFile ReportExecutionFile[]

  @@index([emailStatus])
  @@index([createdAt])
  @@index([status])
  @@index([scheduleId])
}

model ReportExecutionFile {
  id              String          @id
  executionId     String
  format          String
  filename        String
  mimeType        String
  sizeBytes       Int
  content         Bytes
  checksum        String?
  expiresAt       DateTime?
  createdAt       DateTime        @default(now())
  reportExecution ReportExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  @@index([expiresAt])
  @@index([executionId])
}

model ReportSchedule {
  id              String            @id
  name            String
  nameAr          String?
  description     String?
  templateCode    String
  scheduleType    String
  cronExpression  String
  executionTime   String?
  timezone        String            @default("Asia/Riyadh")
  dayOfWeek       Int?
  dayOfMonth      Int?
  filters         String?
  exportFormats   String            @default("xlsx")
  recipients      String
  ccRecipients    String?
  bccRecipients   String?
  emailSubject    String?
  emailBody       String?
  isActive        Boolean           @default(true)
  lastRunAt       DateTime?
  nextRunAt       DateTime?
  lastExecutionId String?
  maxRetries      Int               @default(3)
  retryDelayMin   Int               @default(10)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?
  reportExecution ReportExecution[]

  @@index([scheduleType])
  @@index([nextRunAt])
  @@index([isActive])
}

model Role {
  id          String    @id
  code        String    @unique
  name        String
  nameAr      String?
  description String?
  isSystem    Boolean   @default(false)
  baseType    String    @default("CONTRACTOR")
  permissions Json?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime
  createdBy   String?
  updatedBy   String?
  deletedAt   DateTime?
  user        User[]
}

model SessionCompany {
  id              String          @id
  sessionId       String
  companyId       String
  traineeCount    Int             @default(0)
  addedAt         DateTime        @default(now())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime
  createdBy       String?
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  trainingSession TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, companyId])
  @@index([companyId])
  @@index([sessionId])
}

model SessionEnrollment {
  id                String          @id
  sessionId         String
  traineeId         String
  companyId         String
  enrollmentStatus  String          @default("PENDING")
  enrolledBy        String?
  enrollmentDate    DateTime        @default(now())
  completedDate     DateTime?
  notes             String?
  isReExam          Boolean         @default(false)
  enrollmentSource  String          @default("MANUAL")
  addedByTrainer    Boolean         @default(false)
  pendingReview     Boolean         @default(false)
  attendanceStatus  String          @default("NOT_STARTED")
  preTestStatus     String          @default("PENDING")
  finalTestStatus   String          @default("PENDING")
  evaluationStatus  String          @default("PENDING")
  certificateStatus String          @default("NOT_ELIGIBLE")
  attendanceId      String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime
  createdBy         String?
  updatedBy         String?
  deletedAt         DateTime?
  company           Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  trainee           Trainee         @relation(fields: [traineeId], references: [id], onDelete: Cascade)
  trainingSession   TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, traineeId])
  @@index([certificateStatus])
  @@index([evaluationStatus])
  @@index([finalTestStatus])
  @@index([preTestStatus])
  @@index([attendanceStatus])
  @@index([enrollmentStatus])
  @@index([companyId])
  @@index([traineeId])
  @@index([sessionId])
}

model SessionLifecycleEvent {
  id              String          @id
  sessionId       String
  eventType       String
  eventTime       DateTime        @default(now())
  notes           String?
  createdAt       DateTime        @default(now())
  createdBy       String?
  trainingSession TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([eventType])
  @@index([sessionId])
}

model SessionPayment {
  id              String          @id
  sessionId       String
  companyId       String
  totalAmount     Float           @default(0)
  paidAmount      Float           @default(0)
  currency        String          @default("SAR")
  invoiceRef      String?
  invoiceIssuedAt DateTime?
  invoiceDueDate  DateTime?
  notes           String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime
  createdBy       String?
  updatedBy       String?
  deletedAt       DateTime?
  company         Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  trainingSession TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, companyId])
  @@index([invoiceRef])
  @@index([companyId])
  @@index([sessionId])
}

model Setting {
  id          String   @id
  key         String   @unique
  value       String
  category    String   @default("GENERAL")
  description String?
  isPublic    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  updatedBy   String?
}

model Tenant {
  id        String    @id
  name      String
  nameAr    String?
  code      String    @unique
  status    String    @default("ACTIVE")
  config    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime
  createdBy String?
  updatedBy String?
  deletedAt DateTime?
  company   Company[]
  course    Course[]
  trainer   Trainer[]
  user      User[]

  @@index([status])
}

model TestResult {
  id                String          @id
  refNumber         String          @unique
  sessionId         String
  testType          String
  traineeName       String
  traineeEmail      String?
  traineeIdNational String?
  companyId         String?
  scorePercent      Int
  passed            Boolean
  answers           String?
  attemptedAt       DateTime        @default(now())
  durationSec       Int?
  questionSet       String?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime
  createdBy         String?
  updatedBy         String?
  deletedAt         DateTime?
  company           Company?        @relation(fields: [companyId], references: [id])
  trainingSession   TrainingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([companyId])
  @@index([traineeEmail])
  @@index([sessionId, testType])
}

model Trainee {
  id                           String                         @id
  refNumber                    String                         @unique
  fullName                     String
  nationalId                   String
  nationality                  String?
  jobTitle                     String?
  mobile                       String?
  email                        String?
  companyId                    String
  status                       String                         @default("ACTIVE")
  notes                        String?
  idAttachmentUrl              String?
  // ── Multi-document support (Iqama, ID, Passport, Certificate, Medical, Other) ──
  // JSON-encoded array of { url, filename, type, uploadedAt, uploadedById }.
  // Kept as a single String column on SQLite to avoid a separate join table
  // while still supporting arbitrary document types per trainee.
  documents                    String?
  dateOfBirth                  DateTime?
  idExpiry                     DateTime?
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime
  createdBy                    String?
  updatedBy                    String?
  deletedAt                    DateTime?
  enrollments            SessionEnrollment[]
  company                      Company                        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  trainingRequestCourseTrainee TrainingRequestCourseTrainee[]

  @@index([status])
  @@index([nationalId])
  @@index([companyId])
}

model Trainer {
  id                   String                 @id
  refNumber            String                 @unique
  fullName             String
  fullNameAr           String?
  nationalId           String?                @unique
  email                String?                @unique
  phone                String?
  mobile               String?
  gender               String?
  nationality          String?
  country              String?
  city                 String?
  address              String?
  bio                  String?
  photoUrl             String?
  status               String                 @default("ACTIVE")
  hireDate             DateTime?
  tenantId             String?
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  createdBy            String?
  updatedBy            String?
  deletedAt            DateTime?
  evaluations     CourseEvaluation[]
  tenant               Tenant?                @relation(fields: [tenantId], references: [id])
  qualifications TrainerCertification[]
  trainerQualification TrainerQualification[]
  sessions      TrainingSession[]
  user                 User?

  @@index([tenantId])
  @@index([status])
}

model TrainerCertification {
  id                   String                @id
  trainerId            String
  courseId             String
  qualificationId      String?
  validFrom            DateTime              @default(now())
  validUntil           DateTime?
  status               String                @default("VALID")
  notes                String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime
  createdBy            String?
  updatedBy            String?
  deletedAt            DateTime?
  trainerQualification TrainerQualification? @relation(fields: [qualificationId], references: [id])
  course               Course                @relation(fields: [courseId], references: [id], onDelete: Cascade)
  trainer              Trainer               @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@unique([trainerId, courseId, deletedAt])
  @@index([status])
  @@index([courseId])
  @@index([trainerId])
}

model TrainerQualification {
  id                   String                 @id
  trainerId            String
  title                String
  issuer               String?
  credentialNumber     String?
  issueDate            DateTime?
  expiryDate           DateTime?
  documentUrl          String?
  status               String                 @default("VALID")
  createdAt            DateTime               @default(now())
  updatedAt            DateTime
  createdBy            String?
  updatedBy            String?
  deletedAt            DateTime?
  trainerCertification TrainerCertification[]
  trainer              Trainer                @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([trainerId])
}

model TrainingRequest {
  id                    String                  @id
  refNumber             String                  @unique
  companyId             String
  courseId              String?
  requestedBy           String?
  traineeCount          Int                     @default(0)
  preferredDateFrom     DateTime?
  preferredDateTo       DateTime?
  preferredLocation     String?
  preferredLanguage     String?
  notes                 String?
  // JSON-encoded array of additional request-level documents
  // (medical certificate, vaccination, work permit, company letter, etc.).
  // Each entry: { url, filename, type, uploadedAt, uploadedById }.
  documents             String?
  status                String                  @default("DRAFT")
  priority              String                  @default("NORMAL")
  rejectionReason       String?
  approvedAt            DateTime?
  approvedBy            String?
  submittedAt           DateTime?
  reviewedAt            DateTime?
  scheduledAt           DateTime?
  startedAt             DateTime?
  completedAt           DateTime?
  cancelledAt           DateTime?
  rejectedAt            DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  createdBy             String?
  updatedBy             String?
  deletedAt             DateTime?
  invoices               Invoice[]
  quotations             Quotation[]
  course                Course?                 @relation(fields: [courseId], references: [id])
  company               Company                 @relation(fields: [companyId], references: [id])
  requestCourses TrainingRequestCourse[]
  sessions       TrainingSession[]

  @@index([courseId])
  @@index([companyId])
  @@index([status])
}

model TrainingRequestCourse {
  id                           String                         @id
  requestId                    String
  courseId                     String
  traineeCount                 Int                            @default(0)
  minTrainees                  Int                            @default(10)
  maxTrainees                  Int                            @default(20)
  notes                        String?
  createdAt                    DateTime                       @default(now())
  updatedAt                    DateTime
  createdBy                    String?
  updatedBy                    String?
  deletedAt                    DateTime?
  course                       Course                         @relation(fields: [courseId], references: [id])
  trainingRequest              TrainingRequest                @relation(fields: [requestId], references: [id], onDelete: Cascade)
  trainingRequestCourseTrainee TrainingRequestCourseTrainee[]
  trainingSession              TrainingSession[]

  @@unique([requestId, courseId, deletedAt])
  @@index([courseId])
  @@index([requestId])
}

model TrainingRequestCourseTrainee {
  id                    String                @id
  requestCourseId       String
  traineeId             String
  createdAt             DateTime              @default(now())
  updatedAt             DateTime
  createdBy             String?
  updatedBy             String?
  deletedAt             DateTime?
  trainee               Trainee               @relation(fields: [traineeId], references: [id], onDelete: Cascade)
  trainingRequestCourse TrainingRequestCourse @relation(fields: [requestCourseId], references: [id], onDelete: Cascade)

  @@unique([requestCourseId, traineeId])
  @@index([traineeId])
  @@index([requestCourseId])
}

model TrainingSession {
  id                    String                  @id
  refNumber             String                  @unique
  courseId              String
  requestId             String?
  requestCourseId       String?
  trainerId             String?
  title                 String
  location              String?
  city                  String?
  region                String?
  venue                 String?
  shift                 String?
  durationHours         Int                     @default(6)
  capacity              Int                     @default(20)
  language              String                  @default("en")
  startDate             DateTime
  endDate               DateTime
  expectedTrainees      Int                     @default(0)
  actualTrainees        Int                     @default(0)
  status                String                  @default("SCHEDULED")
  qrCodeToken           String?                 @unique
  qrCodeGeneratedAt     DateTime?
  qrActiveFrom          DateTime?
  qrActiveTo            DateTime?
  lifecycleStatus       String                  @default("NOT_STARTED")
  startedAt             DateTime?
  completedAt           DateTime?
  notes                 String?
  instituteName         String?
  classification        String                  @default("COURSE")
  locationMapUrl        String?
  durationDays          Int?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime
  createdBy             String?
  updatedBy             String?
  deletedAt             DateTime?
  attendance             Attendance[]
  certificates           Certificate[]
  checkIns        CheckInAttempt[]
  evaluations      CourseEvaluation[]
  examAttempts           ExamAttempt[]
  invoice               Invoice[]
  sessionCompanies        SessionCompany[]
  enrollments     SessionEnrollment[]
  sessionLifecycleEvent SessionLifecycleEvent[]
  sessionPayments        SessionPayment[]
  testResults            TestResult[]
  trainer               Trainer?                @relation(fields: [trainerId], references: [id])
  trainingRequestCourse TrainingRequestCourse?  @relation(fields: [requestCourseId], references: [id])
  trainingRequest       TrainingRequest?        @relation(fields: [requestId], references: [id])
  course                Course                  @relation(fields: [courseId], references: [id])

  @@index([lifecycleStatus])
  @@index([requestCourseId])
  @@index([city])
  @@index([shift])
  @@index([startDate])
  @@index([trainerId])
  @@index([status])
}

// ── Retest Management ────────────────────────────────────────────────────
// Tracks the full lifecycle of a retest when a trainee fails the final
// assessment. Linked to the original enrollment (NOT a new request) so the
// trainee's history stays in one place.
model RetestRequest {
  id                  String   @id
  refNumber           String   @unique
  enrollmentId        String
  sessionId           String
  courseId            String
  traineeName         String
  traineeIdNational   String?
  companyId           String?
  // Distinguishes between a Trainer Immediate Opportunity (same session,
  // no notification, no official retest) and an Official Retest (full
  // workflow with contractor notifications + scheduling).
  retestType          String   @default("OFFICIAL")  // "TRAINER_OPPORTUNITY" | "OFFICIAL"
  // The session where the retest will take place. Can be the same session
  // (retest in-place) or a different one (moved to another session).
  retestSessionId     String?
  retestTrainerId     String?
  retestDate          DateTime?
  retestShift         String?
  retestLocation      String?
  retestVenue         String?
  // PENDING_RETEST → SCHEDULED → RESCHEDULED → COMPLETED | CANCELLED
  status              String   @default("PENDING_RETEST")
  // The exam attempt that triggered this retest (the failed one).
  failedAttemptId     String?
  // The exam attempt created for this retest (the new one).
  retestAttemptId     String?
  // Result of the retest: null = not yet taken, true = passed, false = failed
  passed              Boolean?
  reason              String?
  scheduledBy         String?
  scheduledAt         DateTime?
  cancelledBy         String?
  cancelledAt         DateTime?
  cancellationReason  String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime
  createdBy           String?
  updatedBy           String?
  deletedAt           DateTime?

  @@index([enrollmentId])
  @@index([sessionId])
  @@index([status])
  @@index([companyId])
  @@index([retestType])
}

model User {
  id                  String         @id
  email               String         @unique
  passwordHash        String
  fullName            String
  phone               String?
  jobTitle            String?
  role                String         @default("CONTRACTOR")
  roleId              String?
  language            String         @default("en")
  timezone            String?        @default("Asia/Riyadh")
  isActive            Boolean        @default(true)
  accountStatus       String         @default("ACTIVE")
  avatarUrl           String?
  lastLoginAt         DateTime?
  forcePasswordChange Boolean        @default(false)
  failedLoginAttempts Int            @default(0)
  lockedUntil         DateTime?
  tokenVersion        Int            @default(0)
  tenantId            String?
  companyId           String?
  trainerId           String?        @unique
  registrationData    String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime
  createdBy           String?
  updatedBy           String?
  deletedAt           DateTime?
  auditLogs            AuditLog[]
  loginHistories        LoginHistory[]
  notifications        Notification[]
  roleRecord                Role?          @relation(fields: [roleId], references: [id])
  trainer             Trainer?       @relation(fields: [trainerId], references: [id])
  company             Company?       @relation(fields: [companyId], references: [id])
  tenant              Tenant?        @relation(fields: [tenantId], references: [id])

  @@index([accountStatus])
  @@index([tenantId])
  @@index([companyId])
  @@index([role])
}

model WorkerPassport {
  id             String        @id
  passportNumber String        @unique
  nationalId     String        @unique
  fullName       String
  companyId      String?
  jobTitle       String?
  mobile         String?
  email          String?
  qrToken        String        @unique
  qrCodeUrl      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime
  createdBy      String?
  updatedBy      String?
  deletedAt      DateTime?
