# GCCLAB TMS — environment variables
# Copy to .env and fill in real values. Do NOT commit .env.

# Prisma / SQLite database location.
# NOTE: Prisma resolves relative SQLite paths against the schema directory (prisma/),
# not the project root — so this needs the `../` to reach db/custom.db. Using
# `file:./db/custom.db` silently creates an empty prisma/db/custom.db instead.
DATABASE_URL=file:../db/custom.db

# REQUIRED. Secret used to sign session JWTs. Must be at least 32 characters.
# The application will refuse to start if this is missing or too short.
# Generate with: openssl rand -hex 32
JWT_SECRET=

# REQUIRED for the report scheduler. Bearer token the external cron must send
# to POST/GET /api/report-scheduler/tick (Authorization: Bearer <value>).
# Generate with: openssl rand -hex 32
SCHEDULER_SECRET=

# REQUIRED to run `npm run db:seed`. The seed refuses to create a super admin
# without both of these — there is deliberately no default password.
# The password must be at least 12 characters.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Absolute base URL of this deployment. Used to build the QR check-in and
# certificate verification links printed onto PDFs, where no Origin header
# is available. Falls back to the request's Origin/Host when unset.
APP_URL=http://localhost:3000

# ─── Email (optional; report delivery is simulated until SMTP is configured) ───

# Encrypts secret values in the Setting table (currently the SMTP password) at rest.
# Must be at least 32 characters. Deliberately separate from JWT_SECRET so that
# rotating sessions does not silently break email delivery.
# Generate with: openssl rand -hex 32
SETTINGS_SECRET_KEY=

# Takes precedence over the SMTP password stored in Settings. Set this and the
# secret never has to touch the database at all.
SMTP_PASSWORD=

# ─── Cloudinary (file upload storage, optional) ─────────────────────────────
# If these are unset, upload endpoints fall back to local disk storage.
# In production they are set as SECRET env vars in the Render dashboard —
# never commit the API key or secret.
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# ─── AI Copilot Provider (optional) ──────────────────────────────────────────
# If no API key is set, the AI assistant returns a graceful
# "not configured" message instead of crashing.
#
# Provider selection is automatic (priority order):
#   1. Gemini  (if GEMINI_API_KEY is set)
#   2. OpenAI  (if OPENAI_API_KEY is set) — also works with OpenRouter
#   3. NoOp    (fallback)
#
# ─── Gemini (Google AI) ───
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
#
# ─── OpenAI (or any OpenAI-compatible API) ───
# Works with: OpenAI, OpenRouter, Groq, Together AI, LM Studio, Ollama, etc.
#
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
#
# Example — OpenRouter (free models available):
# OPENAI_API_KEY=sk-or-v1-...
# OPENAI_MODEL=google/gemma-4-26b-a4b-it:free
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
