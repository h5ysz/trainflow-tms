# GCCLAB TMS — environment variables
# Copy to .env and fill in real values. Do NOT commit .env.

# Prisma / SQLite database location.
DATABASE_URL=file:./db/custom.db

# REQUIRED. Secret used to sign session JWTs. Must be at least 32 characters.
# The application will refuse to start if this is missing or too short.
# Generate with: openssl rand -hex 32
JWT_SECRET=

# REQUIRED for the report scheduler. Bearer token the external cron must send
# to POST/GET /api/report-scheduler/tick (Authorization: Bearer <value>).
# Generate with: openssl rand -hex 32
SCHEDULER_SECRET=

# Optional. Password for the seeded Super Admin (scripts/seed.ts).
SUPER_ADMIN_PASSWORD=
